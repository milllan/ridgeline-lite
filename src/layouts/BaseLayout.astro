---
/**
 * Base layout used by every page: head (SEO), skip link, header,
 * main content slot, and footer.
 */
import '../styles/global.css';
// Preload the two most visible font files so headings/body never swap
// after first paint (prevents font-driven layout shift).
import barlow700 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import Footer from '../components/common/Footer.astro';
import Header from '../components/common/Header.astro';
import SEO from '../components/common/SEO.astro';
import StickyCallBar from '../components/common/StickyCallBar.astro';
import { siteConfig } from '../config/site';
import { buildLocalBusiness, buildFaqPage } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** FAQ items — renders FAQPage JSON-LD when present. */
  faq?: { question: string; answer: string }[];
}

const { title, description, ogImage, type, noindex } = Astro.props;
const themeAttr = siteConfig.theme === 'blue-amber' ? 'blue-amber' : undefined;
const orgSchema = await buildLocalBusiness(Astro.site!);
const faqSchema = Astro.props.faq?.length
  ? buildFaqPage(Astro.props.faq, new URL(Astro.url.pathname, Astro.site!))
  : null;
---

<!doctype html>
<html lang="sr-Latn" data-theme={themeAttr}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={barlow700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <SEO {title} {description} {ogImage} {type} {noindex} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    {
      import.meta.env.PROD &&
        siteConfig.analytics.statcounterProject > 0 && (
        <>
          <script
            is:inline
            set:html={`var sc_project=${siteConfig.analytics.statcounterProject}; var sc_invisible=1; var sc_security="${siteConfig.analytics.statcounterSecurity}";`}
          />
          <script is:inline async src="https://www.statcounter.com/counter/counter.js" />
        </>
      )
    }
    <slot name="head" />
  </head>
  <body class="bg-white">
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyCallBar />
    <slot name="after-footer" />
  </body>
</html>
