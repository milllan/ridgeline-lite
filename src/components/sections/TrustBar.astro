---
/**
 * Certification strip under the hero. Text badges with generic icons —
 * never real manufacturer logos (trademark/licensing; see CREDITS.md
 * and docs/customization.md for how to swap in official assets you're
 * licensed to use).
 */
import { siteConfig } from '../../config/site';
import Icon from '../common/Icon.astro';
---

<section class="border-b border-slate-200 bg-surface" aria-label="Certifications and credentials">
  <div
    class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-10 gap-y-3 px-4 py-5 sm:px-6 lg:px-8"
  >
    {
      siteConfig.trustBadges.map((badge) => (
        <p class="flex items-center gap-2 text-sm font-semibold text-slate-600">
          <Icon name={badge.icon} class="h-5 w-5 text-primary" />
          {badge.label}
        </p>
      ))
    }
  </div>
</section>
