---
/**
 * Grid of service cards. Each card title links to the service's detail
 * page (/usluge/[slug]/, generated from the services collection) and
 * "Zatražite ponudu" stays as the secondary action. Titles link to
 * details everywhere the grid renders - home, brand and opština pages
 * alike (epic #112 task 9: cards must not dead-end in the quote form).
 */
import type { CollectionEntry } from 'astro:content';
import Icon from '../common/Icon.astro';

interface Props {
  services: CollectionEntry<'services'>[];
}

const { services } = Astro.props;
const detailHref = (service: CollectionEntry<'services'>) =>
  `/usluge/${service.id.replace(/\.mdx$/, '')}/`;
---

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {
    services.map((service) => (
      <div class="flex flex-col rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <span class="flex h-12 w-12 items-center justify-center rounded-md bg-primary/10 text-primary">
          <Icon name={service.data.icon} class="h-6 w-6" />
        </span>
        <h3 class="mt-4 font-heading text-xl font-bold uppercase text-dark">
          <a href={detailHref(service)} class="transition-colors hover:text-primary-ink">
            {service.data.title}
          </a>
        </h3>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{service.data.excerpt}</p>
        <a
          href="/zatrazi-ponudu/"
          class="mt-4 inline-flex items-center gap-1.5 font-heading text-sm font-semibold uppercase tracking-wide text-primary-ink hover:text-dark"
        >
          Zatražite ponudu
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    ))
  }
</div>
