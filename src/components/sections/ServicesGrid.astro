---
/**
 * Grid of service cards. In Ridgeline Lite the cards summarize each
 * service and point to the quote form (the Pro version adds a full
 * detail page per service).
 */
import type { CollectionEntry } from 'astro:content';
import Icon from '../common/Icon.astro';

interface Props {
  services: CollectionEntry<'services'>[];
}

const { services } = Astro.props;
---

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {
    services.map((service) => (
      <div class="flex flex-col rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <span class="flex h-12 w-12 items-center justify-center rounded-md bg-primary/10 text-primary">
          <Icon name={service.data.icon} class="h-6 w-6" />
        </span>
        <h3 class="mt-4 font-heading text-xl font-bold uppercase text-dark">
          {service.data.title}
        </h3>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{service.data.excerpt}</p>
        <a
          href="/zatrazi-ponudu/"
          class="mt-4 inline-flex items-center gap-1.5 font-heading text-sm font-semibold uppercase tracking-wide text-primary-ink hover:text-dark"
        >
          Zatražite ponudu
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    ))
  }
</div>
