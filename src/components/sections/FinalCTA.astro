---
/**
 * Closing call-to-action block used at the bottom of most pages.
 */
import { siteConfig } from '../../config/site';
import Button from '../common/Button.astro';
import Icon from '../common/Icon.astro';

interface Props {
  title?: string;
  lead?: string;
}

const {
  title = 'Get your free quote this week',
  lead = "A 21-point inspection, a photo report you can keep, and a line-item quote within 24 hours — free, and zero pressure either way.",
} = Astro.props;
---

<section class="relative overflow-hidden bg-dark py-16 text-white md:py-20">
  <!-- ridgeline accent -->
  <svg
    class="absolute -right-10 -top-16 h-64 w-auto text-primary/15"
    viewBox="0 0 200 120"
    fill="none"
    aria-hidden="true"
  >
    <path d="M0 120 L60 40 L90 75 L130 10 L200 120 Z" fill="currentColor"></path>
  </svg>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="font-heading text-base font-semibold uppercase tracking-[0.2em] text-primary">
        No pressure. Just a straight answer.
      </p>
      <h2 class="mt-2 font-heading text-3xl font-bold uppercase leading-tight md:text-4xl">
        {title}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-slate-300">{lead}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <Button href="/quote/" size="lg">Start my free quote</Button>
        <Button href={siteConfig.phoneHref} variant="outline-light" size="lg">
          <Icon name="phone" class="h-5 w-5" />
          {siteConfig.phone}
        </Button>
      </div>
      <p class="mt-5 flex items-center gap-2 text-sm text-slate-400">
        <Icon name="zap" class="h-4 w-4 text-primary" />
        {siteConfig.emergencyNote}
      </p>
    </div>
  </div>
</section>
