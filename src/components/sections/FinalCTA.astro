---
/**
 * Closing call-to-action block used at the bottom of most pages.
 */
import { siteConfig } from '../../config/site';
import Button from '../common/Button.astro';
import Icon from '../common/Icon.astro';
import OpenStatusDot from '../common/OpenStatusDot.astro';

interface Props {
  title?: string;
  lead?: string;
}

const {
  title = 'Zatražite ponudu za popravku',
  lead = 'Besplatan dolazak i konstatacija kvara uz popravku, jasna cena pre početka rada – i bez pritiska bilo koje vrste.',
} = Astro.props;
---

<section class="relative overflow-hidden bg-dark py-16 text-white md:py-20">
  <!-- Subtle ambient lighting glow (modern, clean, non-distracting) -->
  <div
    class="pointer-events-none absolute -right-20 -top-20 h-80 w-80 rounded-full bg-primary/15 blur-3xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -bottom-24 right-1/4 h-64 w-64 rounded-full bg-accent/10 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="font-heading text-base font-semibold uppercase tracking-[0.2em] text-primary">
        Bez pritiska. Samo jasna cena.
      </p>
      <h2 class="mt-2 font-heading text-3xl font-bold uppercase leading-tight md:text-4xl">
        {title}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-slate-300">{lead}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <Button href="/zatrazi-ponudu/" size="lg">Zatražite ponudu</Button>
        <Button href={siteConfig.phoneHref} variant="outline-light" size="lg">
          <OpenStatusDot />
          <Icon name="phone" class="h-5 w-5" />
          {siteConfig.phone}
        </Button>
      </div>
      <p class="mt-5 flex items-center gap-2 text-sm text-slate-400">
        <Icon name="zap" class="h-4 w-4 text-primary" />
        {siteConfig.emergencyNote}
      </p>
    </div>
  </div>
</section>
