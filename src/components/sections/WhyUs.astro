---
/**
 * Four differentiators on a dark band — besplatan dolazak i konstatacija,
 * originalni delovi, garancija na rad i delove, izlazak na teren u celom
 * Beogradu (sve marke).
 */
import { siteConfig } from '../../config/site';
import Icon from '../common/Icon.astro';
import SectionHeading from '../common/SectionHeading.astro';

const points = [
  {
    icon: 'search-check',
    title: 'Besplatan dolazak i konstatacija',
    text: 'Majstor dolazi na vašu adresu i utvrđuje kvar na licu mesta. Dolazak i konstatacija kvara su besplatni uz izvršenu popravku — a tačnu cenu znate pre početka rada.',
  },
  {
    icon: 'badge-check',
    title: 'Originalni delovi',
    text: 'Popravljamo originalnim rezervnim delovima, prilagođenim marki vaše mašine — bez jeftinih zamena koje se brže pokvare.',
  },
  {
    icon: 'shield-check',
    title: 'Garancija na rad i delove',
    text: 'Na svaku popravku dajemo garanciju i na naš rad i na ugrađene delove. Sve pojedinosti o garanciji dobijete pre početka popravke.',
  },
  {
    icon: 'map-pin',
    title: 'Izlazak na teren u celom Beogradu',
    text: 'Servisiramo veš mašine svih marki i proizvođača, na terenu u svim beogradskim opštinama — od Rakovice do Zemuna i Novog Beograda.',
  },
];
---

<section class="bg-dark py-16 text-white md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow="Zašto mi"
      title="Popravka kakvu bismo tražili za svoju mašinu"
      lead={`Od ${siteConfig.stats.yearFounded}. godine popravljamo veš mašine širom Beograda — sa više od ${siteConfig.stats.projectsCompleted.toLocaleString('sr-Latn-RS')} završenih popravki. Postupak je jednostavan: dolazak, konstatacija kvara i jasna cena pre početka rada.`}
      onDark
    />
    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        points.map((point) => (
          <div class="rounded-lg bg-dark-soft p-6">
            <span class="flex h-12 w-12 items-center justify-center rounded-md bg-primary text-white">
              <Icon name={point.icon} class="h-6 w-6" />
            </span>
            <h3 class="mt-4 font-heading text-lg font-bold uppercase leading-snug">{point.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-300">{point.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
