---
/**
 * Four differentiators on a dark band – besplatan dolazak i konstatacija,
 * originalni delovi, garancija na rad i delove, izlazak na teren u celom
 * Beogradu (sve marke).
 */
import Icon from '../common/Icon.astro';
import SectionHeading from '../common/SectionHeading.astro';

const points = [
  {
    icon: 'search-check',
    title: 'Besplatan dolazak i konstatacija',
    text: 'Na licu mesta pregledamo mašinu i kažemo u čemu je problem. Dolazak i konstatacija su besplatni uz popravku, a tačnu cenu znate unapred.',
  },
  {
    icon: 'badge-check',
    title: 'Originalni delovi',
    text: 'Za marku vaše mašine ugrađujemo originalne delove. Zamenski deo stavljamo samo uz vašu prethodnu saglasnost.',
  },
  {
    icon: 'shield-check',
    title: 'Garancija na rad i delove',
    text: 'Garancijom pokrivamo i naš rad i ugrađeni deo. Sve uslove znate pre nego što počnemo.',
  },
  {
    icon: 'map-pin',
    title: 'Izlazak na teren u celom Beogradu',
    text: 'Izlazimo na teren u svim beogradskim opštinama, od Zemuna do Rakovice. Servisiramo sve marke veš mašina, a popravku radimo kod vas u stanu.',
  },
];
---

<section class="bg-dark py-16 text-white md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow="Zašto mi"
      title="Čist račun i popravka bez nagađanja"
      lead="Prvo utvrdimo gde je zapelo, pa vam kažemo koliko košta. Konstataciju ne plaćate kada radimo popravku."
      onDark
    />
    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        points.map((point) => (
          <div class="rounded-lg bg-dark-soft p-6">
            <span class="flex h-12 w-12 items-center justify-center rounded-md bg-primary text-white">
              <Icon name={point.icon} class="h-6 w-6" />
            </span>
            <h3 class="mt-4 font-heading text-lg font-bold uppercase leading-snug">{point.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-300">{point.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
