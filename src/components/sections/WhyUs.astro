---
/**
 * Four differentiators on a dark band — free inspections, insurance
 * help, schedule promise, workmanship warranty.
 */
import { siteConfig } from '../../config/site';
import Icon from '../common/Icon.astro';
import SectionHeading from '../common/SectionHeading.astro';

const points = [
  {
    icon: 'search-check',
    title: 'Free 21-Point Inspections',
    text: 'Every job starts with a documented inspection and photo report — and about a third of them end with us saying your roof is fine.',
  },
  {
    icon: 'shield-check',
    title: 'Insurance Claim Support',
    text: 'We document damage the way adjusters are trained to read it, meet them on your roof, and handle the supplement paperwork.',
  },
  {
    icon: 'calendar',
    title: 'Schedules We Actually Keep',
    text: 'Your quote includes a start window and a duration. Crews dry-in every night, and we don’t open more roof than we can close.',
  },
  {
    icon: 'clipboard-check',
    title: `${siteConfig.stats.warrantyYears}-Year Workmanship Warranty`,
    text: 'The manufacturer covers the shingles; we cover the installation — in writing, transferable once if you sell the house.',
  },
];
---

<section class="bg-dark py-16 text-white md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow={`Why ${siteConfig.logoText}`}
      title="Built like we'd build it for our own house"
      lead={`Since ${siteConfig.stats.yearFounded} we've put roofs on more than ${siteConfig.stats.projectsCompleted.toLocaleString('en-US')} homes and buildings across the Denver metro. The process is boring on purpose — documented, scheduled, and warrantied.`}
      onDark
    />
    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        points.map((point) => (
          <div class="rounded-lg bg-dark-soft p-6">
            <span class="flex h-12 w-12 items-center justify-center rounded-md bg-primary text-white">
              <Icon name={point.icon} class="h-6 w-6" />
            </span>
            <h3 class="mt-4 font-heading text-lg font-bold uppercase leading-snug">{point.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-300">{point.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
