---
/**
 * Full-screen home hero: background photo with dark overlay, value
 * proposition, dual CTA (quote + click-to-call), and a trust strip.
 */
import { Image } from 'astro:assets';
import heroImage from '../../assets/hero/home-hero.jpg';
import { siteConfig } from '../../config/site';
import { getAggregateRating } from '../../lib/reviews';
import Button from '../common/Button.astro';
import Icon from '../common/Icon.astro';

const rating = await getAggregateRating();

// Hero badges are translated in place (they do NOT duplicate
// siteConfig.trustBadges – TrustBar already renders that array directly
// below this section on the home page, so reusing it here would show the
// same five badges twice on one screen).
const heroBadges = [
  { icon: 'shield-check', label: 'Garancija na rad i delove' },
  { icon: 'badge-check', label: 'Originalni delovi' },
  { icon: 'star', label: `${rating.average}★ prosek · ${rating.count} recenzija` },
];
---

<section class="relative bg-dark text-white">
  <!-- Fotografija servisera veš mašina na terenu sa dijagnostičkom opremom -->
  <Image
    src={heroImage}
    alt={`${siteConfig.name} – servis i popravka veš mašina na terenu u Beogradu`}
    widths={[768, 1080, 1440, 1920]}
    sizes="100vw"
    quality={55}
    class="absolute inset-0 h-full w-full object-cover"
    loading="eager"
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-dark/70" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 md:py-32 lg:px-8">
    <p class="font-heading text-lg font-semibold uppercase tracking-[0.2em] text-primary">
      Servis i popravka veš mašina · Beograd i okolina
    </p>
    <h1 class="mt-3 max-w-3xl font-heading text-4xl font-bold uppercase leading-tight md:text-5xl">
      {siteConfig.tagline}
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-200">
      Ako mašina tutnji pri centrifugi ili uopšte ne izbacuje vodu, dolazimo na vašu adresu u Beogradu. Popravljamo sve marke. Ugrađujemo originalne delove i dajemo garanciju na rad i delove.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Button href="/zatrazi-ponudu/" size="lg">Zatražite ponudu</Button>
      <Button href={siteConfig.phoneHref} variant="outline-light" size="lg">
        <Icon name="phone" class="h-5 w-5" />
        Pozovite {siteConfig.phone}
      </Button>
    </div>

    <ul class="mt-12 flex flex-wrap gap-x-8 gap-y-3">
      {
        heroBadges.map((badge) => (
          <li class="flex items-center gap-2 text-sm font-medium text-slate-200">
            <Icon name={badge.icon} class="h-5 w-5 text-primary" />
            {badge.label}
          </li>
        ))
      }
    </ul>
  </div>
</section>
