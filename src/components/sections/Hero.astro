---
/**
 * Full-screen home hero: background photo with dark overlay, value
 * proposition, dual CTA (quote + click-to-call), and a trust strip.
 */
import { Image } from 'astro:assets';
import heroImage from '../../assets/hero/home-hero.jpg';
import { siteConfig } from '../../config/site';
import { getAggregateRating } from '../../lib/reviews';
import Button from '../common/Button.astro';
import Icon from '../common/Icon.astro';

const rating = await getAggregateRating();

const heroBadges = [
  { icon: 'shield-check', label: 'Licensed & Insured' },
  { icon: 'badge-check', label: 'GAF Certified Installer' },
  { icon: 'star', label: `${rating.average}★ Average · ${rating.count} Reviews` },
];
---

<section class="relative bg-dark text-white">
  <Image
    src={heroImage}
    alt={`${siteConfig.name} crew installing architectural shingles on a residential roof`}
    widths={[768, 1080, 1440, 1920]}
    sizes="100vw"
    quality={55}
    class="absolute inset-0 h-full w-full object-cover"
    loading="eager"
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-dark/70" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 md:py-32 lg:px-8">
    <p class="font-heading text-lg font-semibold uppercase tracking-[0.2em] text-primary">
      Residential &amp; commercial roofing · Denver metro
    </p>
    <h1 class="mt-3 max-w-3xl font-heading text-4xl font-bold uppercase leading-tight md:text-5xl">
      {siteConfig.tagline}
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-200">
      Roof replacement, storm damage restoration, and repairs — free
      inspections, insurance claim support, and a{" "}{siteConfig.stats.warrantyYears}-year
      workmanship warranty on every roof
      we install.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Button href="/quote/" size="lg">Get a Free Quote</Button>
      <Button href={siteConfig.phoneHref} variant="outline-light" size="lg">
        <Icon name="phone" class="h-5 w-5" />
        Call {siteConfig.phone}
      </Button>
    </div>

    <ul class="mt-12 flex flex-wrap gap-x-8 gap-y-3">
      {
        heroBadges.map((badge) => (
          <li class="flex items-center gap-2 text-sm font-medium text-slate-200">
            <Icon name={badge.icon} class="h-5 w-5 text-primary" />
            {badge.label}
          </li>
        ))
      }
    </ul>
  </div>
</section>
