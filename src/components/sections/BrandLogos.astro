---
/**
 * "Brendovi koje servisiramo" - brand marks linking to /brendovi-ves-masina/[slug]-majstor/ pages
 * (owner decision: real logos, individual files + per-brand SEO alt).
 * Registry (logo paths, alt text, sourcing/trademark note) lives in
 * src/config/brandLogos.ts, shared with the /brendovi-ves-masina/ hub.
 * Brands without a mark fall back to a styled text card (same link,
 * same SEO value via anchor text).
 */
interface Props {
  /** Brand slug to hide (the page you're already on). */
  exclude?: string;
  /** Section heading override. */
  heading?: string;
  /** 'strip' = one-line auto-rotating marquee (grid variant elsewhere). */
  variant?: 'grid' | 'strip';
}

import BrandLogoTile from '../common/BrandLogoTile.astro';
import { getPublished } from '../../lib/collections';
import { brandTiles } from '../../config/brandLogos';

const { exclude = '', heading = 'Neki od brendova mašina za veš koje servisiramo', variant = 'grid' } =
  Astro.props;

const brands = brandTiles;

// Published brands only: a `status: draft` brand's page does not generate,
// so it must not be linked from anywhere (epic #112 task 4). The static
// list carries the logo/alt data; membership comes from the collection.
const published = new Set(
  (await getPublished('brands')).map((brand) => brand.id.replace(/\.mdx$/, '')),
);
const visible = brands.filter((brand) => brand.slug !== exclude && published.has(brand.slug));
---

<section class="bg-surface py-14 md:py-16" aria-labelledby="marke-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2 id="marke-heading" class="text-center font-heading text-xl font-bold uppercase tracking-wide text-dark sm:text-2xl">
      {heading}
    </h2>

    <!-- 'strip' = pure-CSS marquee: duplicated set loops seamlessly; the
         copy is aria-hidden so links are announced once. Reduced-motion
         users get the static wrapped grid instead (see <style> below). -->
    {variant === 'strip' ? (
      <div class="marquee mt-8">
        <div class="marquee__track">
          <ul class="marquee__set">
            {visible.map((brand) => (
              <BrandLogoTile brand={brand} variant="strip" />
            ))}
          </ul>
          <ul class="marquee__set" aria-hidden="true">
            {visible.map((brand) => (
              <BrandLogoTile brand={brand} tabindex={-1} variant="strip" />
            ))}
          </ul>
        </div>
      </div>
    ) : (
      <ul class="mt-8 flex flex-wrap justify-center gap-4">
        {visible.map((brand) => (
          <BrandLogoTile brand={brand} variant="grid" />
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .marquee {
    overflow: hidden;
    /* fade the edges so half-visible logos read as intentional */
    -webkit-mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
    mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
  }

  .marquee__track {
    display: flex;
    gap: 1rem;
    width: max-content;
    animation: rl-marquee 45s linear infinite;
  }

  .marquee__set {
    display: flex;
    flex-shrink: 0;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .marquee:hover .marquee__track,
  .marquee:focus-within .marquee__track {
    animation-play-state: paused;
  }

  /* Shift by exactly one set (50% of track + half the inter-set gap). */
  @keyframes rl-marquee {
    to {
      transform: translateX(calc(-50% - 0.5rem));
    }
  }

  /* The global reduced-motion block freezes all animations; a frozen
     half-cropped strip is useless, so fall back to the static wrap. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .marquee__track {
      display: block;
      width: auto;
      animation: none;
    }
    .marquee__set[aria-hidden='true'] {
      display: none;
    }
    .marquee__set {
      flex-wrap: wrap;
    }
  }
</style>
