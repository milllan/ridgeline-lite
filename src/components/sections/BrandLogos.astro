---
/**
 * "Brendovi koje servisiramo" — brand marks linking to /brendovi-ves-masina/[slug]-majstor/ pages
 * (owner decision: real logos, individual files + per-brand SEO alt).
 * SVGs in public/logos/ sourced from Wikimedia Commons (trademark of
 * respective owners; shown desaturated to signal independent service —
 * the site never claims "ovlašćeni" status). Brands without a mark fall
 * back to a styled text card (same link, same SEO value via anchor text).
 */
interface Props {
  /** Brand slug to hide (the page you're already on). */
  exclude?: string;
  /** Section heading override. */
  heading?: string;
  /** 'strip' = one-line auto-rotating marquee (grid variant elsewhere). */
  variant?: 'grid' | 'strip';
}

import BrandLogoTile from '../common/BrandLogoTile.astro';

const { exclude = '', heading = 'Neki od brendova mašina za veš koje servisiramo', variant = 'grid' } =
  Astro.props;

export interface BrandTile {
  name: string;
  slug: string;
  /** File in /logos/ without extension prefix path. */
  logo?: string;
  alt: string;
}

const brands: BrandTile[] = [
  { name: 'Gorenje', slug: 'gorenje', logo: '/logos/gorenje.svg', alt: 'Servis Gorenje veš mašina Beograd' },
  { name: 'Whirlpool', slug: 'whirlpool', logo: '/logos/whirlpool.svg', alt: 'Servis Whirlpool veš mašina Beograd' },
  { name: 'Indesit', slug: 'indesit', logo: '/logos/indesit.svg', alt: 'Servis Indesit veš mašina Beograd' },
  { name: 'LG', slug: 'lg', logo: '/logos/lg.svg', alt: 'Servis LG veš mašina Beograd' },
  { name: 'Ariston', slug: 'ariston', logo: '/logos/ariston.svg', alt: 'Majstor za Ariston veš mašine Beograd' },
  { name: 'Beko', slug: 'beko', logo: '/logos/beko.svg', alt: 'Servis Beko veš mašina Beograd' },
  { name: 'Samsung', slug: 'samsung', logo: '/logos/samsung.svg', alt: 'Servis Samsung veš mašina Beograd' },
  { name: 'Bosch', slug: 'bosch', alt: 'Servis Bosch veš mašina Beograd' },
  { name: 'Electrolux', slug: 'electrolux', logo: '/logos/electrolux.svg', alt: 'Servis Electrolux veš mašina Beograd' },
  { name: 'Miele', slug: 'miele', logo: '/logos/miele.svg', alt: 'Servis Miele veš mašina Beograd' },
  { name: 'Hisense', slug: 'hisense', logo: '/logos/hisense.svg', alt: 'Servis Hisense veš mašina Beograd' },
  { name: 'VOX', slug: 'vox', alt: 'Servis VOX veš mašina Beograd' },
  { name: 'Tesla', slug: 'tesla', alt: 'Servis Tesla veš mašina Beograd' },
  { name: 'Zanussi', slug: 'zanussi', logo: '/logos/zanussi.svg', alt: 'Servis Zanussi veš mašina Beograd' },
  { name: 'Candy', slug: 'candy', alt: 'Servis Candy veš mašina Beograd' },
];

const visible = brands.filter((brand) => brand.slug !== exclude);
---

<section class="bg-surface py-14 md:py-16" aria-labelledby="marke-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2 id="marke-heading" class="text-center font-heading text-xl font-bold uppercase tracking-wide text-dark sm:text-2xl">
      {heading}
    </h2>

    <!-- 'strip' = pure-CSS marquee: duplicated set loops seamlessly; the
         copy is aria-hidden so links are announced once. Reduced-motion
         users get the static wrapped grid instead (see <style> below). -->
    {variant === 'strip' ? (
      <div class="marquee mt-8">
        <div class="marquee__track">
          <ul class="marquee__set">
            {visible.map((brand) => (
              <BrandLogoTile brand={brand} />
            ))}
          </ul>
          <ul class="marquee__set" aria-hidden="true">
            {visible.map((brand) => (
              <BrandLogoTile brand={brand} tabindex={-1} />
            ))}
          </ul>
        </div>
      </div>
    ) : (
      <ul class="mt-8 flex flex-wrap gap-4">
        {visible.map((brand) => (
          <BrandLogoTile brand={brand} />
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .marquee {
    overflow: hidden;
    /* fade the edges so half-visible logos read as intentional */
    -webkit-mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
    mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
  }

  .marquee__track {
    display: flex;
    gap: 1rem;
    width: max-content;
    animation: rl-marquee 45s linear infinite;
  }

  .marquee__set {
    display: flex;
    flex-shrink: 0;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .marquee:hover .marquee__track,
  .marquee:focus-within .marquee__track {
    animation-play-state: paused;
  }

  /* Shift by exactly one set (50% of track + half the inter-set gap). */
  @keyframes rl-marquee {
    to {
      transform: translateX(calc(-50% - 0.5rem));
    }
  }

  /* The global reduced-motion block freezes all animations; a frozen
     half-cropped strip is useless, so fall back to the static wrap. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .marquee__track {
      display: block;
      width: auto;
      animation: none;
    }
    .marquee__set[aria-hidden='true'] {
      display: none;
    }
    .marquee__set {
      flex-wrap: wrap;
    }
  }
</style>
