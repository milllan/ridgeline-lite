---
/**
 * FAQ accordion — details/summary only, zero JS (epic #28 C, #22 §3).
 * Items are passed by the page; the same array feeds buildFaqPage()
 * JSON-LD via BaseLayout's `faq` prop, so markup and schema never drift.
 */
import Icon from '../common/Icon.astro';

export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  items: FaqItem[];
  /** Render on the surface tint instead of white — for pages whose
     section order would otherwise put two same-bg bands adjacent. */
  surface?: boolean;
}

const { title, items, surface = false } = Astro.props;
---

<section
  id="faq"
  class:list={['py-16 md:py-20', surface ? 'bg-surface' : 'bg-white']}
  aria-labelledby="faq-heading"
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <h2 id="faq-heading" class="font-heading text-2xl font-bold uppercase tracking-wide text-dark sm:text-3xl">
      {title}
    </h2>
    <div class="mt-8 space-y-4">
      {
        items.map((item) => (
          <details class="group rounded-lg border border-slate-200 bg-white p-5 shadow-sm open:border-primary/40">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-xl font-bold uppercase tracking-wide text-dark [&::-webkit-details-marker]:hidden">
              {item.question}
              <Icon
                name="chevron-down"
                class="h-5 w-5 shrink-0 text-primary transition-transform group-open:rotate-180"
              />
            </summary>
            <p class="mt-3 leading-relaxed text-slate-600">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
