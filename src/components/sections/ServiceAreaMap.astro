---
/**
 * Lightweight SVG map of the service area — municipality dots positioned
 * by their real coordinates. Deliberately NOT an embedded Google Map: no
 * API key, no third-party JS, no layout shift. (docs/customization.md
 * covers swapping in a real embed if a buyer insists.)
 */

// NOTE: coordinates are approximate municipality centers, not exact
// administrative boundaries.
// TODO: verify with the business which areas are actually covered.
//
// Workshop pin: the majstor's real address (Vidikovački venac 104,
// Rakovica), per OSM Nominatim house-level match — shown as a distinct
// pin, separate from the municipality dots. Coordinates come from
// siteConfig.geo (single source of truth, also feeds the JSON-LD).
//
// Savski venac is omitted from the dot list: its center lies within ~3 km
// of the neighbouring central municipalities and its label collides in the
// projected layout. The "I OKOLINA" caption note covers the wider service area.
import { siteConfig } from '../../config/site';

const municipalities = [
  { name: 'Zemun', latitude: 44.842, longitude: 20.409 },
  { name: 'Novi Beograd', latitude: 44.8065, longitude: 20.4128 },
  { name: 'Čukarica', latitude: 44.77, longitude: 20.39 },
  { name: 'Voždovac', latitude: 44.7578, longitude: 20.4783 },
  { name: 'Vračar', latitude: 44.793, longitude: 20.468 },
  { name: 'Zvezdara', latitude: 44.811, longitude: 20.482 },
  { name: 'Palilula', latitude: 44.815, longitude: 20.5 },
  { name: 'Rakovica', latitude: 44.6978, longitude: 20.4507 },
  { name: 'Stari grad', latitude: 44.817, longitude: 20.457 },
];

// Linear projection of Belgrade's lat/lng bounds onto the SVG canvas.
const BOUNDS = { lngMin: 20.33, lngMax: 20.55, latMin: 44.66, latMax: 44.87 };
const W = 400;
const H = 300;

const positioned = municipalities.map((municipality) => {
  const { latitude, longitude } = municipality;
  const x = ((longitude - BOUNDS.lngMin) / (BOUNDS.lngMax - BOUNDS.lngMin)) * W;
  const y = ((BOUNDS.latMax - latitude) / (BOUNDS.latMax - BOUNDS.latMin)) * H;
  return { name: municipality.name, x: Math.round(x), y: Math.round(y) };
});

// Workshop ("Naša lokacija") pin — projected with the same math.
// NOTE: its label is manually anchored (right of the pin); the placement
// algorithm above only governs municipality labels — re-check visually
// (or via the projection assertions) if geo or BOUNDS change.
const workshop = {
  x: Math.round(
    ((siteConfig.geo.longitude - BOUNDS.lngMin) / (BOUNDS.lngMax - BOUNDS.lngMin)) * W,
  ),
  y: Math.round(
    ((BOUNDS.latMax - siteConfig.geo.latitude) / (BOUNDS.latMax - BOUNDS.latMin)) * H,
  ),
};

/**
 * Collision-aware label placement: labels go to the right of their dot
 * unless a neighboring dot is in the way — then to the left, or above.
 *
 * Boundary coupling (verify visually if coordinates/BOUNDS change):
 * Palilula (x=309) clears `nearRightEdge` (W-90=310) by 1px.
 * When both sides are blocked (Stari grad & Zvezdara), labels fall back
 * above their dots to avoid colliding with Vračar (y=110) below.
 * Blockers: Stari grad ← Novi Beograd / → Zvezdara; Zvezdara ← Stari
 * grad / → Palilula.
 */
const dots = positioned.map((dot) => {
  const blockedRight = positioned.some(
    (other) =>
      other !== dot &&
      other.x - dot.x > 0 &&
      other.x - dot.x < 120 &&
      Math.abs(other.y - dot.y) < 26,
  );
  const blockedLeft = positioned.some(
    (other) =>
      other !== dot &&
      dot.x - other.x > 0 &&
      dot.x - other.x < 120 &&
      Math.abs(other.y - dot.y) < 26,
  );
  const nearRightEdge = dot.x > W - 90;

  let anchor = 'start';
  let dx = 12;
  let dy = 4;
  if ((blockedRight || nearRightEdge) && !blockedLeft) {
    anchor = 'end';
    dx = -12;
  } else if (blockedRight && blockedLeft) {
    // Both sides blocked: fall back to placing above.
    // Stari grad (x=231) centers directly above its dot; Zvezdara (x=276)
    // shifts top-right (dx=12, dy=-24) to clear Stari grad's label and Palilula's halo.
    if (dot.name === 'Zvezdara') {
      anchor = 'start';
      dx = 12;
      dy = -24;
    } else {
      anchor = 'middle';
      dx = 0;
      dy = -18;
    }
  }
  return { ...dot, anchor, dx, dy };
});
---

<svg
  viewBox={`0 0 ${W} ${H}`}
  class="h-auto w-full rounded-lg"
  role="img"
  aria-label="Mapa opština u Beogradu u kojima vršimo servis"
>
  <title>Beograd – mapa opština u kojima vršimo servis</title>
  <rect width={W} height={H} rx="8" class="fill-dark-soft"></rect>

  <!-- Stylised Sava and Danube rivers, meeting near Kalemegdan -->
  <polyline
    points="182,0 191,43 204,68 264,100 291,121 318,143 364,164 395,179"
    fill="none"
    class="stroke-slate-500"
    stroke-width="3"
    stroke-linejoin="round"
    stroke-linecap="round"
    opacity="0.35"></polyline>
  <polyline
    points="45,136 91,121 136,110 173,95 204,68"
    fill="none"
    class="stroke-slate-500"
    stroke-width="3"
    stroke-linejoin="round"
    stroke-linecap="round"
    opacity="0.35"></polyline>
  <text x="210" y="30" class="fill-slate-500" font-size="10" letter-spacing="2">
    DUNAV
  </text>
  <text x="48" y="155" class="fill-slate-500" font-size="10" letter-spacing="2">
    SAVA
  </text>

  <!-- Subtle grid -->
  {
    [1, 2, 3].map((i) => (
      <line
        x1={(W / 4) * i}
        y1="0"
        x2={(W / 4) * i}
        y2={H}
        class="stroke-white/5"
        stroke-width="1"
      />
    ))
  }
  {
    [1, 2].map((i) => (
      <line
        x1="0"
        y1={(H / 3) * i}
        x2={W}
        y2={(H / 3) * i}
        class="stroke-white/5"
        stroke-width="1"
      />
    ))
  }

  {
    dots.map(({ name, x, y, anchor, dx, dy }) => (
      <g>
        <circle cx={x} cy={y} r="14" class="fill-primary/20" />
        <circle cx={x} cy={y} r="6" class="fill-primary" />
        <text
          x={x + dx}
          y={y + dy}
          text-anchor={anchor}
          class="fill-white font-semibold"
          font-size="13"
        >
          {name}
        </text>
      </g>
    ))
  }

  <!-- Workshop pin: distinct from municipality dots (ring + bright core). -->
  <g>
    <circle cx={workshop.x} cy={workshop.y} r="12" class="fill-primary/15" />
    <circle
      cx={workshop.x}
      cy={workshop.y}
      r="5"
      class="fill-primary-bright stroke-white"
      stroke-width="1.5"
    />
    <text
      x={workshop.x + 13}
      y={workshop.y + 4}
      class="fill-white font-semibold"
      font-size="11"
    >
      Naša lokacija
    </text>
  </g>

  <text x="16" y={H - 16} class="fill-slate-500" font-size="10" letter-spacing="2">
    BEOGRAD · I OKOLINA
  </text>
</svg>
