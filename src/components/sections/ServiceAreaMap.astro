---
/**
 * Lightweight SVG map of the service area — city dots positioned by
 * their real coordinates, each linked to its city page. Deliberately
 * NOT an embedded Google Map: no API key, no third-party JS, no layout
 * shift. (docs/customization.md covers swapping in a real embed if a
 * buyer insists.)
 */
/** Service-area cities shown on the map (edit freely). */
const cities = [
  { name: 'Denver', latitude: 39.7392, longitude: -104.9903 },
  { name: 'Aurora', latitude: 39.7294, longitude: -104.8319 },
  { name: 'Lakewood', latitude: 39.7047, longitude: -105.0814 },
  { name: 'Centennial', latitude: 39.5807, longitude: -104.8772 },
  { name: 'Arvada', latitude: 39.8028, longitude: -105.0875 },
  { name: 'Boulder', latitude: 40.015, longitude: -105.2705 },
];

// Linear projection of the metro's lat/lng bounds onto the SVG canvas.
const BOUNDS = { lngMin: -105.46, lngMax: -104.64, latMin: 39.47, latMax: 40.13 };
const W = 400;
const H = 300;

const positioned = cities.map((city) => {
  const { latitude, longitude } = city;
  const x = ((longitude - BOUNDS.lngMin) / (BOUNDS.lngMax - BOUNDS.lngMin)) * W;
  const y = ((BOUNDS.latMax - latitude) / (BOUNDS.latMax - BOUNDS.latMin)) * H;
  return { name: city.name, x: Math.round(x), y: Math.round(y) };
});

/**
 * Collision-aware label placement: labels go to the right of their dot
 * unless a neighboring dot is in the way — then to the left, or below.
 */
const dots = positioned.map((dot) => {
  const blockedRight = positioned.some(
    (other) =>
      other !== dot &&
      other.x - dot.x > 0 &&
      other.x - dot.x < 120 &&
      Math.abs(other.y - dot.y) < 26,
  );
  const blockedLeft = positioned.some(
    (other) =>
      other !== dot &&
      dot.x - other.x > 0 &&
      dot.x - other.x < 120 &&
      Math.abs(other.y - dot.y) < 26,
  );
  const nearRightEdge = dot.x > W - 90;

  let anchor = 'start';
  let dx = 12;
  let dy = 4;
  if ((blockedRight || nearRightEdge) && !blockedLeft) {
    anchor = 'end';
    dx = -12;
  } else if (blockedRight && blockedLeft) {
    anchor = 'middle';
    dx = 0;
    dy = 26;
  }
  return { ...dot, anchor, dx, dy };
});
---

<svg
  viewBox={`0 0 ${W} ${H}`}
  class="h-auto w-full rounded-lg"
  aria-label="Map of the Denver metro cities we serve"
>
  <title>Denver metro service area map</title>
  <rect width={W} height={H} rx="8" class="fill-dark-soft"></rect>

  <!-- Front Range foothills silhouette -->
  <path
    d={`M0 ${H} L0 120 L22 96 L40 118 L58 78 L74 108 L92 60 L108 96 L122 74 L134 100 L146 88 L154 112 L160 ${H} Z`}
    class="fill-dark"
    opacity="0.85"></path>
  <text x="16" y={H - 16} class="fill-slate-500" font-size="10" letter-spacing="2">
    FRONT RANGE
  </text>

  <!-- Subtle grid -->
  {
    [1, 2, 3].map((i) => (
      <line
        x1={(W / 4) * i}
        y1="0"
        x2={(W / 4) * i}
        y2={H}
        class="stroke-white/5"
        stroke-width="1"
      />
    ))
  }
  {
    [1, 2].map((i) => (
      <line
        x1="0"
        y1={(H / 3) * i}
        x2={W}
        y2={(H / 3) * i}
        class="stroke-white/5"
        stroke-width="1"
      />
    ))
  }

  {
    dots.map(({ name, x, y, anchor, dx, dy }) => (
      <g>
        <circle cx={x} cy={y} r="14" class="fill-primary/20" />
        <circle cx={x} cy={y} r="6" class="fill-primary" />
        <text
          x={x + dx}
          y={y + dy}
          text-anchor={anchor}
          class="fill-white font-semibold"
          font-size="13"
        >
          {name}
        </text>
      </g>
    ))
  }
</svg>
