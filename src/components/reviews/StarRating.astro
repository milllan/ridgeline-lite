---
/**
 * Accessible star rating rendered as inline SVG (filled/empty stars).
 */
interface Props {
  rating: number;
  /** Tailwind size class for each star. */
  starClass?: string;
}

const { rating, starClass = 'h-4 w-4' } = Astro.props;
const stars = [1, 2, 3, 4, 5];
---

<div
  class="flex items-center gap-0.5"
  role="img"
  aria-label={`Ocena ${rating} od 5 zvezdica`}
>
  {
    stars.map((n) => (
      <svg
        viewBox="0 0 24 24"
        class:list={[starClass, n <= Math.round(rating) ? 'text-amber-400' : 'text-slate-300']}
        fill="currentColor"
        aria-hidden="true"
      >
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
      </svg>
    ))
  }
</div>
