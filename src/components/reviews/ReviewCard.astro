---
/**
 * Google-style review card: star rating, review text, author line.
 */
import type { CollectionEntry } from 'astro:content';
import StarRating from './StarRating.astro';

interface Props {
  review: CollectionEntry<'reviews'>;
  class?: string;
}

const { review, class: className = '' } = Astro.props;

const dateLabel = review.data.date.toLocaleDateString('sr-Latn-RS', {
  month: 'long',
  year: 'numeric',
  // z.coerce.date() yields UTC midnights - pin the zone so a 1st-of-month
  // date can't roll back a month on a UTC-negative build machine.
  timeZone: 'UTC',
});
---

<article
  class:list={[
    'flex h-full flex-col rounded-lg border border-slate-200 bg-white p-6 shadow-sm',
    className,
  ]}
>
  <div class="flex items-center justify-between gap-3">
    <StarRating rating={review.data.rating} />
    <span class="text-xs text-slate-500">{dateLabel}</span>
  </div>
  <p class="mt-4 flex-1 text-sm leading-relaxed text-slate-600">
    “{review.data.text}”
  </p>
  <footer class="mt-5 border-t border-slate-100 pt-4">
    <p class="font-semibold text-dark">{review.data.author}</p>
    <p class="mt-0.5 text-xs text-slate-500">
      {review.data.city} · {review.data.service}
    </p>
  </footer>
</article>
