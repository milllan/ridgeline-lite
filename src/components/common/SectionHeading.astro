---
/**
 * Consistent section heading: small orange eyebrow, condensed
 * uppercase title, optional lead paragraph.
 */
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  /** Set true on dark section backgrounds. */
  onDark?: boolean;
  /** Heading level (defaults to h2). */
  level?: 'h1' | 'h2' | 'h3';
}

const {
  eyebrow,
  title,
  lead,
  align = 'left',
  onDark = false,
  level: Tag = 'h2',
} = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']}>
  {
    eyebrow && (
      <p
        class:list={[
          'font-heading text-base font-semibold uppercase tracking-[0.2em]',
          onDark ? 'text-primary' : 'text-primary-ink',
        ]}
      >
        {eyebrow}
      </p>
    )
  }
  <Tag
    class:list={[
      'mt-2 font-heading text-3xl font-bold uppercase leading-tight md:text-4xl',
      onDark ? 'text-white' : 'text-dark',
    ]}
  >
    {title}
  </Tag>
  {
    lead && (
      <p class:list={['mt-4 text-lg leading-relaxed', onDark ? 'text-slate-300' : 'text-slate-600']}>
        {lead}
      </p>
    )
  }
</div>
