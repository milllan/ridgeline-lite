---
/**
 * Breadcrumb trail shown on every page except the home page.
 * The last item is the current page (no link).
 */
import Icon from './Icon.astro';

export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
  /** Set true when rendered on a dark hero. */
  onDark?: boolean;
}

const { items, onDark = false } = Astro.props;
const crumbs: Crumb[] = [{ label: 'Početna', href: '/' }, ...items];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((crumb, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.label,
    // Google's Rich Results test warns when the terminal crumb omits
    // `item`, so fall back to the current page's canonical URL. Only
    // the terminal crumb gets the fallback: an href-less intermediate
    // has no page of its own and must not reuse the page canonical
    // (all current intermediates - Usluge, Lokacije, Marke - link to
    // their hubs, but the guard stays for future crumb sets).
    ...(crumb.href
      ? { item: new URL(crumb.href, Astro.site).href }
      : i === crumbs.length - 1 && {
          item: new URL(Astro.url.pathname, Astro.site).href,
        }),
  })),
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<nav aria-label="Putanja">
  <ol
    class:list={[
      'flex flex-wrap items-center gap-1.5 text-sm',
      onDark ? 'text-slate-300' : 'text-slate-500',
    ]}
  >
    {
      crumbs.map((crumb, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && <Icon name="chevron-right" class="h-3.5 w-3.5 opacity-60" />}
          {crumb.href ? (
            <a
              href={crumb.href}
              class:list={[
                'transition-colors',
                onDark ? 'hover:text-white' : 'hover:text-primary-ink',
              ]}
            >
              {crumb.label}
            </a>
          ) : (
            <span
              aria-current="page"
              class:list={[onDark ? 'font-medium text-white' : 'font-medium text-dark']}
            >
              {crumb.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
