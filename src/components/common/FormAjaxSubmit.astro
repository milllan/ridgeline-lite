---
/**
 * Progressive enhancement for Formspree forms. The free tier does not
 * guarantee the `_next` redirect, so when JS is available we submit via
 * fetch (Accept: application/json) and redirect to /hvala/ ourselves.
 * Without JS the native POST still reaches Formspree, and `_next`
 * (kept in FormBackendFields) redirects whenever the plan honors it.
 * Renders nothing; include once per page that has a form.
 */
---

<script>
  function enhanceFormspreeForms() {
    const forms = document.querySelectorAll<HTMLFormElement>(
      'form[action*="formspree.io"]',
    );
    forms.forEach((form) => {
      if (form.dataset.enhanced === 'true') return;
      form.dataset.enhanced = 'true';
      let isSubmitting = false;

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (isSubmitting) return;
        isSubmitting = true;

        const button = form.querySelector<HTMLButtonElement>(
          'button[type="submit"]',
        );
        const status = form.querySelector<HTMLElement>('[data-form-status]');
        if (button) button.disabled = true;
        if (status) status.textContent = 'Slanje…';

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          if (response.ok) {
            window.location.assign('/hvala/');
            return;
          }
        } catch {
          /* mreža ili CORS – pada na poruku ispod */
        }

        isSubmitting = false;
        if (button) button.disabled = false;
        if (status) {
          status.textContent =
            'Slanje nije uspelo. Pokušajte ponovo ili nas pozovite.';
        }
      });
    });
  }

  enhanceFormspreeForms();
</script>
