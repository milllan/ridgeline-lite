---
/**
 * Provider-specific hidden fields + spam honeypot. Include once inside
 * every <form>.
 *
 *  - Netlify:   needs a `form-name` field and the honeypot input named
 *               in the form's `netlify-honeypot` attribute.
 *  - Formspree: `_gotcha` is Formspree's native honeypot; `_next`
 *               redirects to the thank-you page after submission.
 *
 * The honeypot input is visually hidden but present for bots; real
 * users never see it (aria-hidden + tabindex -1 keep it out of the
 * accessibility tree and tab order).
 */
import { isNetlify } from '../../lib/forms';

interface Props {
  formName: string;
}

const { formName } = Astro.props;
const thankYouUrl = new URL('/hvala/', Astro.site).href;
/** Human-readable form name for the lead-email subject (Serbian). */
const formLabel = formName === 'quote' ? 'zahtev za ponudu' : 'kontakt';
---

{isNetlify && <input type="hidden" name="form-name" value={formName} />}
{!isNetlify && <input type="hidden" name="_next" value={thankYouUrl} />}
{!isNetlify && <input type="hidden" name="_subject" value={`Novi upit sa sajta – ${formLabel}`} />}

<p class="hidden" aria-hidden="true">
  <label>
    Don't fill this out if you're human:
    {/* honeypot – sakriveno od korisnika i čitača ekrana; tekst je namerno
       generičan da ne asistuje botovima na bilo kom jeziku */}
    <input
      type="text"
      name={isNetlify ? 'bot-field' : '_gotcha'}
      tabindex="-1"
      autocomplete="off"
    />
  </label>
</p>
