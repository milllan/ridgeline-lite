---
/**
 * Mobile sticky action bar (§7.2): Call Now + Free Quote pinned to the
 * bottom of the viewport on small screens, appearing after the visitor
 * scrolls past the first screen. Body padding is toggled together with
 * the bar so it never covers page content.
 */
import { siteConfig } from '../../config/site';
import Icon from './Icon.astro';
---

<!-- Sentinel: while this (viewport-tall, zero-width) marker is on
     screen we're still in the first screenful, so the bar stays hidden. -->
<div data-scb-sentinel class="pointer-events-none absolute left-0 top-0 h-screen w-px" aria-hidden="true"></div>

<nav
  id="sticky-call-bar"
  aria-label="Brzi kontakt"
  class="fixed inset-x-0 bottom-0 z-40 grid translate-y-full grid-cols-2 shadow-[0_-4px_12px_rgba(15,23,42,0.15)] transition-transform duration-300 lg:hidden"
>
  <a
    href={siteConfig.phoneHref}
    class="flex min-h-[56px] items-center justify-center gap-2 bg-dark font-heading text-base font-bold uppercase tracking-wide text-white"
  >
    <Icon name="phone" class="h-5 w-5 text-primary" />
    Pozovite odmah
  </a>
  <a
    href="/zatrazi-ponudu/"
    class="flex min-h-[56px] items-center justify-center gap-2 bg-primary font-heading text-base font-bold uppercase tracking-wide text-on-primary"
  >
    <Icon name="file-text" class="h-5 w-5" />
    Zatražite ponudu
  </a>
</nav>

<style is:global>
  /* Reserve space under the page content while the bar is shown. */
  @media (max-width: 1023px) {
    body.scb-visible {
      padding-bottom: 56px;
    }
  }
  body.scb-visible #sticky-call-bar {
    /* Tailwind v4's translate-y-full uses the `translate` property. */
    translate: 0 0;
  }
</style>

<script>
  const bar = document.getElementById('sticky-call-bar');
  const sentinel = document.querySelector('[data-scb-sentinel]');

  if (bar && sentinel && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(([entry]) => {
      document.body.classList.toggle('scb-visible', !entry.isIntersecting);
    });
    observer.observe(sentinel);
  }
</script>
