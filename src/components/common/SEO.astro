---
/**
 * Per-page SEO head tags: title, description, canonical,
 * Open Graph and Twitter cards. Used once inside BaseLayout.
 */
import { siteConfig } from '../../config/site';

interface Props {
  /** Page title (site name is appended automatically). */
  title: string;
  description: string;
  /** Path or absolute URL of the social sharing image. */
  ogImage?: string;
  /** Open Graph type. Use 'article' for blog posts. */
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = siteConfig.seo.ogImage,
  type = 'website',
  noindex = false,
} = Astro.props;

const hasBrandOrMajstor =
  title.toLowerCase().includes(siteConfig.seo.siteName.toLowerCase()) ||
  title.includes('Majstor Dejan');
const fullTitle = hasBrandOrMajstor
  ? title
  : `${title} | ${siteConfig.seo.siteName}`;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.seo.siteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
