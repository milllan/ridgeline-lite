---
/**
 * Site footer. All company data comes from src/config/site.ts.
 */
import { getPublished } from '../../lib/collections';
import { siteConfig, hasEmail } from '../../config/site';
import { footerLocationsNav } from '../../config/nav';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const opstine = (await getPublished('opstine')).sort(
  (a, b) => a.data.order - b.data.order,
);

const brands = (await getPublished('brands')).sort(
  (a, b) => a.data.order - b.data.order,
);

const POPULAR_BRAND_SLUGS = ['gorenje', 'candy', 'samsung', 'beko'];
const popularBrands = POPULAR_BRAND_SLUGS.map((slug) =>
  brands.find((brand) => brand.id.replace(/\.mdx$/, '') === slug),
).filter((brand) => brand !== undefined);

const year = new Date().getFullYear();
const { address } = siteConfig;

/* Branding-description prose links (owner copy 2026-09-21): every
   location/brand name links to its page only when a published one
   exists - collection-driven, so a draft can never leave a dead prose
   link (same choke-point rule as the link columns). */
const opstineSlugs = new Set(opstine.map((o) => o.id.replace(/\.mdx$/, '')));
const brandSlugByName = new Map(
  brands.map((b) => [b.data.name.toLowerCase(), b.id.replace(/\.mdx$/, '')]),
);

interface ProseToken {
  text: string;
  href?: string;
  /** Separator rendered after this token (", ", " / ", "." or ""). */
  sep?: string;
}

const loc = (text: string, slug: string, sep = ', '): ProseToken => ({
  text,
  sep,
  href: opstineSlugs.has(slug) ? `/lokacije/${slug}/` : undefined,
});

const brand = (text: string, sep = ', '): ProseToken => ({
  text,
  sep,
  href: brandSlugByName.has(text.toLowerCase())
    ? `/brendovi-ves-masina/${brandSlugByName.get(text.toLowerCase())}-majstor/`
    : undefined,
});

const locTokens: ProseToken[] = [
  // { text: 'Servis veš mašina na terenu, Beograd', sep: ', ' },
  // loc('Stari Grad', 'stari-grad'),
  // loc('Vračar', 'vracar'),
  // loc('Savski Venac', 'savski-venac'),
  // loc('Novi Beograd', 'novi-beograd'),
  // { text: 'Zemun' },
  // loc('Rakovica', 'rakovica'),
  // { text: 'Voždovac', sep: '.' },

  { text: 'Servis veš mašina na terenu, Beograd', sep: '. ' }
];

const brandTokens: ProseToken[] = [
  brand('Gorenje'),
  brand('Beko'),
  brand('Bosch'),
  brand('Candy'),
  brand('Indesit', ' / '),
  brand('Ariston'),
  brand('Samsung'),
  brand('LG'),
  brand('Whirlpool'),
  brand('VOX'),
  brand('Vivax'),
  brand('Favorit', ''),
];

/* "Lokacije" column order (owner 2026-09-22): Stari grad first, Rakovica
   last, "Sve lokacije" link under the list. Footer-specific on purpose -
   the global `order` frontmatter keeps driving the hub/homepage/kontakt
   lists. Slugs outside this list still append, so a new opština page can
   never be silently missing from the footer. */
const FOOTER_OPSTINE_SLUGS = [
  'stari-grad',
  'novi-beograd',
  'savski-venac',
  'vracar',
  'rakovica',
];
const footerOpstine = [
  ...FOOTER_OPSTINE_SLUGS.map((slug) =>
    opstine.find((o) => o.id.replace(/\.mdx$/, '') === slug),
  ).filter((o) => o !== undefined),
  ...opstine.filter(
    (o) => !FOOTER_OPSTINE_SLUGS.includes(o.id.replace(/\.mdx$/, '')),
  ),
];

/** Non-empty social profiles - empty values render nothing at all. */
const socials = (
  [
    { name: 'Facebook', loc: 'Facebooku', url: siteConfig.social.facebook, icon: 'facebook' },
    { name: 'Instagram', loc: 'Instagramu', url: siteConfig.social.instagram, icon: 'instagram' },
  ] as const
).filter((social) => social.url !== '');
---

<footer class="bg-dark text-slate-300">
  <!-- Trust badge strip -->
  <div class="border-b border-white/10">
    <div
      class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-8 gap-y-3 px-4 py-5 sm:px-6 lg:px-8"
    >
      {
        siteConfig.trustBadges.map((badge) => (
          <p class="flex items-center gap-2 text-sm font-medium text-slate-200">
            <Icon name={badge.icon} class="h-5 w-5 text-primary" />
            {badge.label}
          </p>
        ))
      }
    </div>
  </div>

  <!-- Main columns: logo track is 2fr, Kontakt 1.5fr (address/radno vreme
       need the extra width), Marke and Lokacije 1fr each. -->
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:grid-cols-2 sm:px-6 lg:grid-cols-[2fr_1fr_1fr_1.5fr] lg:px-8">
    <div>
      <a href="/" aria-label={`${siteConfig.name}, Početna`}>
        <Logo onDark />
      </a>
      <div class="mt-4 space-y-1 text-sm leading-relaxed">
        <p>
          {locTokens.map((t) => (
            <>
              {t.href ? <a href={t.href} class="transition-colors hover:text-primary">{t.text}</a> : t.text}{t.sep}
            </>
          ))}
        </p>
        <p>Original delovi, garancija na rad.</p>
        <p>
          {brandTokens.map((t) => (
            <>
              {t.href ? <a href={t.href} class="transition-colors hover:text-primary">{t.text}</a> : t.text}{t.sep}
            </>
          ))}
        </p>
      </div>
      {
        socials.length > 0 && (
          <ul class="mt-5 flex gap-3">
            {socials.map((social) => (
              <li>
                <a
                  href={social.url}
                  class="flex h-10 w-10 items-center justify-center rounded-md bg-white/10 text-slate-200 transition-colors hover:bg-primary hover:text-white"
                  aria-label={`Pratite nas na ${social.loc}`}
                >
                  <Icon name={social.icon} class="h-5 w-5" />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <nav aria-label="Marke">
      <h2 class="font-heading text-lg font-bold uppercase tracking-wide text-white">
        Marke
      </h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          popularBrands.map((brand) => (
            <li>
              <a
                href={`/brendovi-ves-masina/${brand.id.replace(/\.mdx$/, '')}-majstor/`}
                class="transition-colors hover:text-primary"
              >
                {brand.data.name}
              </a>
            </li>
          ))
        }
        <li><a href="/brendovi-ves-masina/" class="transition-colors hover:text-primary">Svi brendovi</a></li>
      </ul>
    </nav>

    <nav aria-label="Lokacije">
      <h2 class="font-heading text-lg font-bold uppercase tracking-wide text-white">
        Lokacije
      </h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          footerOpstine.map((opstina) => (
            <li>
              <a
                href={`/lokacije/${opstina.id.replace(/\.mdx$/, '')}/`}
                class="transition-colors hover:text-primary"
              >
                {opstina.data.title.replace('Servis veš mašina ', '')}
              </a>
            </li>
          ))
        }
        {
          footerLocationsNav.map((item) => (
            <li>
              <a href={item.href} class="transition-colors hover:text-primary">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="font-heading text-lg font-bold uppercase tracking-wide text-white">
        Kontakt
      </h2>
      <address class="mt-4 space-y-3 text-sm not-italic">
        <p class="flex items-start gap-2.5">
          <Icon name="map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
          <span>
            <a
              href={siteConfig.gbpUrl}
              target="_blank"
              rel="noopener"
              class="transition-colors hover:text-primary"
            >
              {address.street}<br />
              {address.zip} {address.city}
            </a>
          </span>
        </p>
        <p>
          <a
            href={siteConfig.phoneHref}
            class="flex items-center gap-2.5 font-semibold text-white transition-colors hover:text-primary"
          >
            <Icon name="phone" class="h-4 w-4 shrink-0 text-primary" />
            {siteConfig.phone}
          </a>
        </p>
        {hasEmail && (
          <p>
            <a
              href={`mailto:${siteConfig.email}`}
              class="flex items-center gap-2.5 break-all transition-colors hover:text-primary"
            >
              <Icon name="mail" class="h-4 w-4 shrink-0 text-primary" />
              {siteConfig.email}
            </a>
          </p>
        )}
      </address>
      <h3 class="mt-6 font-heading text-base font-bold uppercase tracking-wide text-white">
        Radno vreme
      </h3>
      <ul class="mt-2 space-y-1 text-sm">
        {
          siteConfig.hours.map((row) => (
            <li class="flex justify-between gap-4">
              <span>{row.days}</span>
              <span class="text-slate-400">
                {row.close ? `${row.open} - ${row.close}` : row.open}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="mt-2 flex items-center gap-2 text-sm text-primary">
        <Icon name="zap" class="h-4 w-4" />
        {siteConfig.emergencyNote}
      </p>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div
      class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 px-4 py-5 text-xs text-slate-400 sm:flex-row sm:px-6 lg:px-8"
    >
      <p>
        © {year} {siteConfig.name} · {siteConfig.licenseLine} · Sva prava zadržana.
      </p>
      <p class="text-slate-500">
        Web dizajn, hosting i SEO:
        <a
          href="https://wpspeedopt.net/"
          class="transition-colors hover:text-primary"
        >wpspeedopt.net</a>
      </p>
    </div>
  </div>
</footer>
