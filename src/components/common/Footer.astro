---
/**
 * Site footer. All company data comes from src/config/site.ts.
 * Per the Ridgeline Lite license, please keep the "Made with
 * Ridgeline" credit link — it's how the free version stays free.
 */
import { getCollection } from 'astro:content';
import { siteConfig } from '../../config/site';
import { footerCompanyNav } from '../../config/nav';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order,
);

const year = new Date().getFullYear();
const { address } = siteConfig;

/** Where the credit link points — the Ridgeline Pro page. */
const PRO_URL = 'https://ridgeline-demo.vercel.app';
---

<footer class="bg-dark text-slate-300">
  <!-- Trust badge strip -->
  <div class="border-b border-white/10">
    <div
      class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-8 gap-y-3 px-4 py-5 sm:px-6 lg:px-8"
    >
      {
        siteConfig.trustBadges.map((badge) => (
          <p class="flex items-center gap-2 text-sm font-medium text-slate-200">
            <Icon name={badge.icon} class="h-5 w-5 text-primary" />
            {badge.label}
          </p>
        ))
      }
    </div>
  </div>

  <!-- Main columns -->
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-8">
    <div>
      <a href="/" aria-label={`${siteConfig.name} — home`}>
        <Logo onDark />
      </a>
      <p class="mt-4 text-sm leading-relaxed">
        Residential and commercial roofing across the Denver metro since
        {siteConfig.stats.yearFounded}. Free inspections, insurance claim help,
        and a {siteConfig.stats.warrantyYears}-year workmanship warranty on
        every roof we install.
      </p>
      <ul class="mt-5 flex gap-3">
        <li>
          <a
            href={siteConfig.social.facebook}
            class="flex h-10 w-10 items-center justify-center rounded-md bg-white/10 text-slate-200 transition-colors hover:bg-primary hover:text-white"
            aria-label="Follow us on Facebook"
          >
            <Icon name="facebook" class="h-5 w-5" />
          </a>
        </li>
        <li>
          <a
            href={siteConfig.social.instagram}
            class="flex h-10 w-10 items-center justify-center rounded-md bg-white/10 text-slate-200 transition-colors hover:bg-primary hover:text-white"
            aria-label="Follow us on Instagram"
          >
            <Icon name="instagram" class="h-5 w-5" />
          </a>
        </li>
      </ul>
    </div>

    <nav aria-label="Services">
      <h2 class="font-heading text-lg font-bold uppercase tracking-wide text-white">
        Services
      </h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          services.map((service) => (
            <li>
              <a href="/services/" class="transition-colors hover:text-primary">
                {service.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Company">
      <h2 class="font-heading text-lg font-bold uppercase tracking-wide text-white">
        Company
      </h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          footerCompanyNav.map((item) => (
            <li>
              <a href={item.href} class="transition-colors hover:text-primary">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="font-heading text-lg font-bold uppercase tracking-wide text-white">
        Contact
      </h2>
      <address class="mt-4 space-y-3 text-sm not-italic">
        <p class="flex items-start gap-2.5">
          <Icon name="map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
          <span>
            {address.street}<br />
            {address.city}, {address.state} {address.zip}
          </span>
        </p>
        <p>
          <a
            href={siteConfig.phoneHref}
            class="flex items-center gap-2.5 font-semibold text-white transition-colors hover:text-primary"
          >
            <Icon name="phone" class="h-4 w-4 shrink-0 text-primary" />
            {siteConfig.phone}
          </a>
        </p>
        <p>
          <a
            href={`mailto:${siteConfig.email}`}
            class="flex items-center gap-2.5 transition-colors hover:text-primary"
          >
            <Icon name="mail" class="h-4 w-4 shrink-0 text-primary" />
            {siteConfig.email}
          </a>
        </p>
      </address>
      <h3 class="mt-6 font-heading text-base font-bold uppercase tracking-wide text-white">
        Hours
      </h3>
      <ul class="mt-2 space-y-1 text-sm">
        {
          siteConfig.hours.map((row) => (
            <li class="flex justify-between gap-4">
              <span>{row.days}</span>
              <span class="text-slate-400">
                {row.close ? `${row.open} – ${row.close}` : row.open}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="mt-2 flex items-center gap-2 text-sm text-primary">
        <Icon name="zap" class="h-4 w-4" />
        {siteConfig.emergencyNote}
      </p>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div
      class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 px-4 py-5 text-xs text-slate-400 sm:flex-row sm:px-6 lg:px-8"
    >
      <p>
        © {year} {siteConfig.name} · {siteConfig.licenseLine} · All rights reserved.
      </p>
      <p>
        Made with Ridgeline —
        <a href={PRO_URL} class="font-medium text-slate-300 underline underline-offset-2 transition-colors hover:text-white">
          get the full version
        </a>
      </p>
    </div>
  </div>
</footer>
