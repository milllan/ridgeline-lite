---
/**
 * Site header:
 *  - Utility top bar (license + hours + emergency line) on md+
 *  - Sticky main bar: logo, primary nav, phone CTA, quote button
 *  - Mobile disclosure menu (native TS, no framework)
 *
 * The phone number is always visible on desktop and is a tel: link.
 */
import { siteConfig } from '../../config/site';
import { mainNav, secondaryNav } from '../../config/nav';
import Button from './Button.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import OpenStatusDot from './OpenStatusDot.astro';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<!-- Utility top bar -->
<div class="hidden bg-dark text-sm text-slate-300 md:block">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2 sm:px-6 lg:px-8">
    <p class="flex items-center gap-2">
      <Icon name="shield-check" class="h-4 w-4 text-primary" />
      {siteConfig.licenseLine}
    </p>
    <div class="flex items-center gap-6">
      <p class="flex items-center gap-2">
        <Icon name="clock" class="h-4 w-4" />
        {
          siteConfig.hours
            .map((row) =>
              row.close ? `${row.days} ${row.open}–${row.close}` : `${row.days}: ${row.open}`,
            )
            .join(' · ')
        }
      </p>
      <a
        href={siteConfig.phoneHref}
        class="flex items-center gap-2 font-semibold text-white hover:text-primary"
      >
        <Icon name="zap" class="h-4 w-4 text-primary" />
        Pozovite odmah: {siteConfig.phone}
      </a>
    </div>
  </div>
</div>

<!-- Sticky main bar -->
<header class="sticky top-0 z-50 border-b border-slate-200 bg-white shadow-sm">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="min-w-0" aria-label={`${siteConfig.name}, Početna`}>
      <Logo />
    </a>

    <!-- Desktop nav -->
    <nav aria-label="Glavna navigacija" class="hidden lg:block">
      <ul class="flex items-center gap-6">
        {
          mainNav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'font-heading text-lg font-semibold uppercase tracking-wide transition-colors hover:text-primary-ink',
                  isActive(item.href) ? 'text-primary-ink' : 'text-dark',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <!-- Desktop phone -->
      <a
        href={siteConfig.phoneHref}
        class="hidden items-center gap-2 font-heading text-xl font-bold text-dark transition-colors hover:text-primary-ink lg:flex"
      >
        <OpenStatusDot />
        <Icon name="phone" class="h-5 w-5 text-primary" />
        {siteConfig.phone}
      </a>
      <!-- Hidden on the narrowest screens – the sticky call bar carries
           the quote CTA there. (Wrapper div: Button's own display class
           would conflict with `hidden`.) -->
      <div class="hidden sm:block">
        <Button href="/zatrazi-ponudu/">Zatražite ponudu</Button>
      </div>

      <!-- Mobile phone shortcut -->
      <a
        href={siteConfig.phoneHref}
        class="flex h-11 w-11 items-center justify-center rounded-md bg-primary text-on-primary lg:hidden"
        aria-label={`Pozovite ${siteConfig.name} na broj ${siteConfig.phone}`}
      >
        <Icon name="phone" class="h-5 w-5" />
      </a>

      <!-- Mobile menu toggle -->
      <button
        type="button"
        id="menu-toggle"
        class="flex h-11 w-11 items-center justify-center rounded-md border border-slate-300 text-dark lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span class="sr-only">Otvori glavni meni</span>
        <span id="menu-icon-open"><Icon name="menu" class="h-6 w-6" /></span>
        <span id="menu-icon-close" class="hidden"><Icon name="x" class="h-6 w-6" /></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu panel -->
  <div id="mobile-menu" class="hidden border-t border-slate-200 bg-white lg:hidden">
    <nav aria-label="Mobilna navigacija" class="mx-auto max-w-7xl px-4 py-4 sm:px-6">
      <ul class="divide-y divide-slate-100">
        {
          [...mainNav, ...secondaryNav].map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'block py-3 font-heading text-xl font-semibold uppercase tracking-wide',
                  isActive(item.href) ? 'text-primary-ink' : 'text-dark',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-4 grid gap-3">
        <Button href="/zatrazi-ponudu/" class="w-full">Zatražite ponudu</Button>
        <a
          href={siteConfig.phoneHref}
          class="flex items-center justify-center gap-2 rounded-md border-2 border-dark px-5 py-3 font-heading text-base font-semibold uppercase tracking-wide text-dark"
        >
          <Icon name="phone" class="h-5 w-5" />
          {siteConfig.phone}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const panel = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  function setMenu(open: boolean) {
    if (!toggle || !panel || !iconOpen || !iconClose) return;
    toggle.setAttribute('aria-expanded', String(open));
    panel.classList.toggle('hidden', !open);
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    setMenu(!open);
  });

  // Close the menu with the Escape key and return focus to the toggle.
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      toggle.focus();
    }
  });
</script>
