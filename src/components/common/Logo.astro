---
/**
 * Text-based logo lock-up with the "ridgeline" roof-peak mark.
 * Purely typographic + inline SVG, so buyers can rebrand by editing
 * logoText / logoSuffix in src/config/site.ts - no image editing.
 */
import { siteConfig } from '../../config/site';

interface Props {
  /** Set true when rendering on a dark background (footer). */
  onDark?: boolean;
}

const { onDark = false } = Astro.props;
---

<span class="flex min-w-0 items-center gap-2.5">
  <svg
    viewBox="0 0 40 40"
    class="h-9 w-9"
    aria-hidden="true"
    fill="none"
  >
    <rect width="40" height="40" rx="6" class="fill-dark"></rect>
    <path
      d="M7 26 L20 12 L33 26"
      stroke="var(--rl-primary)"
      stroke-width="4"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <path
      d="M14 30 L20 23.5 L26 30"
      stroke="#ffffff"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <span class="flex min-w-0 flex-col leading-none">
    <span
      class:list={[
        'font-heading text-2xl font-bold uppercase tracking-wide min-w-0',
        onDark ? 'text-white' : 'text-dark',
      ]}
    >
      {siteConfig.logoText}
    </span>
    {siteConfig.logoSuffix && (
      <span
        class:list={[
          'font-heading text-[0.7rem] font-semibold uppercase tracking-[0.3em]',
          onDark ? 'text-slate-400' : 'text-slate-500',
        ]}
      >
        {siteConfig.logoSuffix}
      </span>
    )}
    {siteConfig.logoSubtitle && (
      <span
        class:list={[
          'mt-1 font-heading text-[0.62rem] font-semibold uppercase tracking-[0.16em]',
          onDark ? 'text-slate-400' : 'text-primary-ink',
        ]}
      >
        {siteConfig.logoSubtitle}
      </span>
    )}
  </span>
</span>
