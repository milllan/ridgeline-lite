interface Props {
  /** Icon name — must exist in the `icons` record above. */
  name: string;
  /** Tailwind classes for sizing/coloring, e.g. "h-5 w-5". */
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = 'h-6 w-6', strokeWidth = 2 } = Astro.props;
const paths = icons[name];
if (!paths) {
  throw new Error(`[Icon] Unknown icon name: "${name}". Add it to src/components/common/Icon.astro.`);
}
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={paths}
/>
