---
/**
 * Link styled as a button. All CTAs across the template use this
 * component so button styling stays consistent.
 *
 * Variants:
 *  - primary       - safety-orange CTA (default)
 *  - outline-light - white outline, for use on dark backgrounds
 *  - dark          - solid dark, for use on light backgrounds
 */

interface Props {
  href: string;
  variant?: 'primary' | 'outline-light' | 'dark';
  size?: 'md' | 'lg';
  class?: string;
  /** Accessible label when the visible text needs more context. */
  ariaLabel?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  ariaLabel,
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md font-heading font-semibold uppercase tracking-wide transition-colors';

const variants: Record<string, string> = {
  primary: 'bg-primary text-on-primary hover:bg-primary-bright',
  'outline-light':
    'border-2 border-white/80 text-white hover:border-white hover:bg-white/10',
  dark: 'bg-dark text-white hover:bg-dark-soft',
};

const sizes: Record<string, string> = {
  md: 'px-5 py-3 text-base',
  lg: 'px-7 py-4 text-lg',
};
---

<a
  href={href}
  aria-label={ariaLabel}
  class:list={[base, variants[variant], sizes[size], className]}
>
  <slot />
</a>
