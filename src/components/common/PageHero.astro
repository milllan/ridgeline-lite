---
/**
 * Interior page hero: dark band with breadcrumbs, H1, optional lead
 * and optional background photo.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from './Breadcrumbs.astro';

interface Props {
  title: string;
  lead?: string;
  crumbs: Crumb[];
  image?: ImageMetadata;
  imageAlt?: string;
}

const { title, lead, crumbs, image, imageAlt = '' } = Astro.props;
---

<section class="relative bg-dark text-white">
  {
    image && (
      <>
        <Image
          src={image}
          alt={imageAlt}
          widths={[768, 1280, 1920]}
          sizes="100vw"
          class="absolute inset-0 h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-dark/75" aria-hidden="true" />
      </>
    )
  }
  <div class="relative mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-20 lg:px-8">
    <Breadcrumbs items={crumbs} onDark />
    <h1 class="mt-4 max-w-3xl font-heading text-4xl font-bold uppercase leading-tight md:text-5xl">
      {title}
    </h1>
    {lead && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-200">{lead}</p>}
    <slot />
  </div>
</section>
