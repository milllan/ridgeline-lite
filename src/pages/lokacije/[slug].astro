---
/**
 * Opština landing pages (/lokacije/[slug]/) — issue #25.
 * Rakovica first; 2nd opština = one content file, zero code changes.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/common/PageHero.astro';
import Button from '../../components/common/Button.astro';
import Icon from '../../components/common/Icon.astro';
import ServicesGrid from '../../components/sections/ServicesGrid.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import FaqSection from '../../components/sections/FaqSection.astro';
import BrandLogos from '../../components/sections/BrandLogos.astro';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const opstine = await getCollection('opstine');
  return opstine.map((opstina) => ({
    params: { slug: opstina.id.replace(/\.mdx$/, '') },
    props: { opstina },
  }));
}

const { opstina } = Astro.props;
const { Content } = await render(opstina);
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={opstina.data.seoTitle} description={opstina.data.excerpt} faq={opstina.data.faq}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: `${opstina.data.title} – popravka i servis`,
      serviceType: 'Servis veš mašina',
      provider: { '@id': new URL('/#local-business', Astro.site).href },
      areaServed: [
        { '@type': 'AdministrativeArea', name: `Beograd – ${opstina.data.title.replace('Servis veš mašina ', '')}` },
        ...opstina.data.naselja.map((n) => ({ '@type': 'Place', name: n })),
      ],
    })}
    slot="head"
  />
  <PageHero
    title={opstina.data.title}
    lead={opstina.data.excerpt}
    crumbs={[{ label: 'Lokacije' }, { label: opstina.data.title }]}
  />

  <BrandLogos
    heading="Neki od brendova koje servisiramo"
    variant="strip"
  />

  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="space-y-4 leading-relaxed text-slate-600">
        <Content />
      </div>

      <h2 class="mt-10 font-heading text-xl font-bold uppercase text-dark">
        Naselja koja pokrivamo
      </h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          opstina.data.naselja.map((naselje) => (
            <li class="rounded-full border border-slate-200 bg-surface px-4 py-1.5 text-sm font-medium text-slate-600">
              {naselje}
            </li>
          ))
        }
      </ul>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <Button href={siteConfig.phoneHref}>
          <Icon name="phone" class="h-5 w-5" />
          Pozovite {siteConfig.phone}
        </Button>
        <a
          href="/zatrazi-ponudu/"
          class="inline-flex items-center gap-1.5 font-heading text-sm font-semibold uppercase tracking-wide text-primary-ink hover:text-dark"
        >
          Zatražite ponudu
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <section class="bg-surface py-16 md:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl font-bold uppercase text-dark">
        Usluge servis mašine za veš na lokaciji {opstina.data.title.replace('Servis veš mašina ', '')}
      </h2>
      <div class="mt-8">
        <ServicesGrid services={services} />
      </div>
    </div>
  </section>

  {opstina.data.faq && opstina.data.faq.length > 0 && (
    <FaqSection title={`Najčešća pitanja: ${opstina.data.title.replace('Servis veš mašina ', '')}`} items={opstina.data.faq} />
  )}

  <FinalCTA />
</BaseLayout>
