---
/**
 * Services page — Lite edition: all six services on one page with
 * photos and process overviews. (Ridgeline Pro gives each service its
 * own landing page with FAQs and related projects.)
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/common/PageHero.astro';
import Button from '../../components/common/Button.astro';
import Icon from '../../components/common/Icon.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Roofing Services"
  description="Roof replacement, repair, storm damage restoration, gutters, inspections, and commercial roofing across the Denver metro — all inspected, quoted, and warrantied by one local crew."
>
  <PageHero
    title="Roofing services"
    lead="Six services, one standard: documented inspections, line-item quotes, and a 10-year workmanship warranty behind the installation."
    crumbs={[{ label: 'Services' }]}
  />

  <section class="bg-surface py-16 md:py-20">
    <div class="mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:px-8">
      {
        services.map((service, i) => (
          <article class="grid overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm md:grid-cols-2">
            <div class:list={['relative aspect-video md:aspect-auto md:min-h-full', i % 2 === 1 && 'md:order-last']}>
              <Image
                src={service.data.heroImage}
                alt={service.data.heroImageAlt}
                widths={[480, 768, 1200]}
                sizes="(min-width: 768px) 50vw, 100vw"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
            <div class="p-7 md:p-9">
              <span class="flex h-12 w-12 items-center justify-center rounded-md bg-primary/10 text-primary">
                <Icon name={service.data.icon} class="h-6 w-6" />
              </span>
              <h2 class="mt-4 font-heading text-2xl font-bold uppercase text-dark">
                {service.data.title}
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{service.data.excerpt}</p>
              <ol class="mt-5 space-y-2">
                {service.data.processSteps.map((step, n) => (
                  <li class="flex items-start gap-2.5 text-sm text-slate-600">
                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-sm bg-primary/10 font-heading text-xs font-bold text-primary-ink">
                      {n + 1}
                    </span>
                    <span>
                      <strong class="font-semibold text-dark">{step.title}.</strong> {step.description}
                    </span>
                  </li>
                ))}
              </ol>
              <div class="mt-6">
                <Button href="/quote/">Get a free quote</Button>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <FinalCTA
    title="Not sure which service you need?"
    lead="Start with the free inspection — we'll tell you what's actually going on up there and quote only what the roof needs."
  />
</BaseLayout>
