---
/**
 * Home page – Lite edition (8 sections): Hero → TrustBar → Services →
 * MajstorBelt → WhyUs → Reviews → FAQ → FinalCTA. The Pro version adds featured
 * before/after projects, the service-area system, and financing.
 */
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import heroImage from '../assets/hero/home-hero.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import ServicesGrid from '../components/sections/ServicesGrid.astro';
import WhyUs from '../components/sections/WhyUs.astro';
import ReviewsCarousel from '../components/reviews/ReviewsCarousel.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import Button from '../components/common/Button.astro';
import Icon from '../components/common/Icon.astro';
import OpenStatusDot from '../components/common/OpenStatusDot.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import SectionHeading from '../components/common/SectionHeading.astro';
import { siteConfig } from '../config/site';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order,
);

// Opšta pitanja za naslovnu (epic #22 §3) – razlikuju se od simptomskih
// pitanja na /usluge/ da FAQPage šeme ne dupliraju sadržaj.
const homeFaq = [
  {
    question: 'Koliko košta dolazak i konstatacija kvara?',
    answer:
      'Uz izvršenu popravku dolazak i konstatacija kvara su besplatni. Tačnu cenu popravke znate pre početka rada, bez skrivenih troškova.',
  },
  {
    question: 'Da li preuzimate mašinu u radionicu?',
    answer:
      'Da – obimnije popravke, recimo zamenu ležajeva, radimo u radionici: mašinu preuzimamo kod vas i vraćamo je popravljenu. Manje kvarove rešavamo kod vas u stanu.',
  },
  {
    question: 'Radite li vikendom?',
    answer:
      'Hitne pozive vikendom primamo po dogovoru – pozovite nas i dogovorićemo termin koji vama odgovara.',
  },
];

// Preload the hero image (the LCP element).
const heroPreload = await getImage({
  src: heroImage,
  widths: [768, 1080, 1440, 1920],
  sizes: '100vw',
  quality: 55,
});
---

<BaseLayout
  title={siteConfig.seo.defaultTitle}
  description={siteConfig.seo.defaultDescription}
  faq={homeFaq}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    imagesrcset={heroPreload.srcSet.attribute}
    imagesizes="100vw"
    fetchpriority="high"
  />
  <Hero />
  <TrustBar />

  <section class="bg-surface py-16 md:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Servis na terenu"
        title="Popravka veš mašina svih marki"
        lead="Bilo da bubanj lupa pri centrifugi ili da voda ostaje u mašini posle pranja, dolazimo na vašu adresu da nađemo kvar. Cenu znate pre početka rada."
        align="center"
      />
      <div class="mt-12">
        <ServicesGrid services={services} />
      </div>
    </div>
  </section>

  <!-- Majstor-targeting belt (#22 §2, epic #28 E): the H2 targets the
       "majstor za veš mašinu" cluster without touching the H1. -->
  <section class="bg-white py-16 md:py-20" aria-labelledby="majstor-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-8 rounded-lg border border-slate-200 bg-surface p-8 shadow-sm md:grid-cols-[1fr_auto] md:p-10">
        <div>
          <h2 id="majstor-heading" class="font-heading text-2xl font-bold uppercase tracking-wide text-dark sm:text-3xl">
            Majstor za veš mašinu – Beograd
          </h2>
          <p class="mt-4 max-w-2xl leading-relaxed text-slate-600">
            Vašu mašinu popravlja majstor Dejan – manje kvarove otklanja kod vas u stanu,
            u svim beogradskim opštinama, a za obimnije popravke preuzima mašinu u radionicu
            i vraća je popravljenu. Pozovite ga direktno i dogovorite termin.
          </p>
          <a
            href="/o-nama/"
            class="mt-4 inline-flex items-center gap-1.5 font-heading text-sm font-semibold uppercase tracking-wide text-primary-ink hover:text-dark"
          >
            Upoznajte majstora Dejana
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>
        <div class="flex flex-col items-start gap-3 md:items-end">
          <Button href={siteConfig.phoneHref}>
            <OpenStatusDot inLink />
            <Icon name="phone" class="h-5 w-5" />
            {siteConfig.phone}
          </Button>
        </div>
      </div>
    </div>
  </section>

  <WhyUs />
  <ReviewsCarousel />
  <FaqSection title="Najčešća pitanja" items={homeFaq} />

  <FinalCTA />
</BaseLayout>
