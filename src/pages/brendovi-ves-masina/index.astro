---
/**
 * /brendovi-ves-masina/ brands hub (epic #112 task 19): all serviced
 * brands on one page, mirroring the /lokacije/ hub (#116). Each card
 * links to the brand's /brendovi-ves-masina/[slug]-majstor/ page; the
 * "Marke" breadcrumb crumb on brand pages and the footer "Marke"
 * column link here. Owner decision 2026-09-20: the business
 * services ANY brand (the "Sve marke mašina" badge is confirmed
 * true); the 14 brand pages are examples, and the lead below says so.
 */
import { getPublished } from '../../lib/collections';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/common/PageHero.astro';
import Button from '../../components/common/Button.astro';
import Icon from '../../components/common/Icon.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import { brandTiles } from '../../config/brandLogos';
import { siteConfig } from '../../config/site';

const brands = (await getPublished('brands')).sort(
  (a, b) => a.data.order - b.data.order,
);

// Mark data (logo path + alt) from the shared registry so hub cards and
// BrandLogos tiles show identical marks; registry-only brands without a
// logo file fall back to the h3 text (same rule as BrandLogoTile).
const tileBySlug = new Map(brandTiles.map((tile) => [tile.slug, tile]));
---

{/* Meta description u <BaseLayout> niže ručno nabraja prvih nekoliko
    marki: kod dodavanja nove marke ažurirati i nju. */}
<BaseLayout
  title="Servis veš mašina po markama u Beogradu"
  description={`Servis veš mašina po markama u Beogradu: Gorenje, Samsung, Beko i ostale marke. Popravka na adresi ili u radionici. Pozovite ${siteConfig.phone}.`}
>
  <PageHero
    title="Servis veš mašina po markama"
    lead="Servisiramo sve marke veš mašina, a Gorenje, Samsung, Beko i Candy su samo neke od njih. Za svaku marku sa liste vodimo posebnu stranicu: sa kodovima grešaka gde mašina ima displej i kvarovima koje na njoj rešavamo. Manje kvarove rešavamo na vašoj adresi, a obimnije popravke u radionici na Vidikovačkom vencu, uz preuzimanje mašine i vraćanje popravljene."
    crumbs={[{ label: 'Marke' }]}
  />

  <section class="bg-surface py-16 md:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl font-bold uppercase text-dark">
        Marke koje servisiramo
      </h2>
      <p class="mt-3 max-w-2xl text-slate-600">
        Izaberite marku svoje mašine i pogledajte koje kvarove na njoj
        rešavamo i kako teče popravka.
      </p>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          brands.map((brand) => {
            const slug = brand.id.replace(/\.mdx$/, '');
            const tile = tileBySlug.get(slug);
            return (
              <li>
                <a
                  href={`/brendovi-ves-masina/${slug}-majstor/`}
                  class="group flex h-full flex-col rounded-lg border border-slate-200 bg-white p-7 shadow-sm transition-colors hover:border-primary/50 focus-visible:border-primary/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30"
                >
                  {tile?.logo && (
                    <img
                      src={tile.logo}
                      alt={`Logotip ${brand.data.name}`}
                      width={110}
                      height={40}
                      loading="lazy"
                      class="mb-5 max-h-10 w-auto self-start opacity-70 grayscale transition-all group-hover:opacity-100 group-hover:grayscale-0"
                    />
                  )}
                  <h3 class="font-heading text-xl font-bold uppercase text-dark transition-colors group-hover:text-primary-ink">
                    {brand.data.title}
                  </h3>
                  <p class="mt-3 text-sm leading-relaxed text-slate-600">
                    {brand.data.excerpt}
                  </p>
                  <span class="mt-auto inline-flex items-center gap-1.5 pt-5 font-heading text-sm font-semibold uppercase tracking-wide text-primary-ink group-hover:text-dark">
                    Detaljnije
                    <Icon name="arrow-right" class="h-4 w-4" />
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl font-bold uppercase text-dark">
        Po usluzi ili po kraju grada
      </h2>
      <p class="mt-3 max-w-2xl text-slate-600">
        Popravku možete potražiti i preko usluge koja vam treba ili kraja
        grada u kom živite.
      </p>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <a
          href="/usluge/"
          class="group flex gap-5 rounded-lg border border-slate-200 bg-surface p-7 shadow-sm transition-colors hover:border-primary/50 focus-visible:border-primary/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30"
        >
          <span
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md bg-primary/10 text-primary"
          >
            <Icon name="wrench" class="h-6 w-6" />
          </span>
          <span>
            <h3
              class="font-heading text-lg font-bold uppercase text-dark transition-colors group-hover:text-primary-ink"
            >
              Usluge servisa veš mašina
            </h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600">
              Od zamene pumpe i grejača do popravke elektronike i ležajeva:
              svaka usluga ima stranicu sa opisom postupka popravke.
            </p>
          </span>
        </a>
        <a
          href="/lokacije/"
          class="group flex gap-5 rounded-lg border border-slate-200 bg-surface p-7 shadow-sm transition-colors hover:border-primary/50 focus-visible:border-primary/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30"
        >
          <span
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md bg-primary/10 text-primary"
          >
            <Icon name="map-pin" class="h-6 w-6" />
          </span>
          <span>
            <h3
              class="font-heading text-lg font-bold uppercase text-dark transition-colors group-hover:text-primary-ink"
            >
              Lokacije servisa u Beogradu
            </h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600">
              Opštine i naselja koji pokriva terenski servis, sa
              radionicom na Vidikovačkom vencu iz koje majstor kreće na
              adrese.
            </p>
          </span>
        </a>
      </div>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <Button href={siteConfig.phoneHref}>
          <Icon name="phone" class="h-5 w-5" />
          Pozovite {siteConfig.phone}
        </Button>
        <a
          href="/zatrazi-ponudu/"
          class="inline-flex items-center gap-1.5 font-heading text-sm font-semibold uppercase tracking-wide text-primary-ink hover:text-dark"
        >
          Zatražite ponudu
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <FinalCTA
    title="Pozovite nas za marku koju imate"
    lead="Recite nam marku i model mašine i šta se dešava sa njom. Konstatacija kvara je besplatna uz popravku, a cenu znate pre početka rada."
  />
</BaseLayout>
