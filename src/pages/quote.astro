---
/**
 * Quote request page — Lite edition: a single-step form.
 * (Ridgeline Pro replaces this with a 4-step Quote Wizard with
 * per-step validation and anti-spam heuristics.)
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/common/PageHero.astro';
import FormBackendFields from '../components/common/FormBackendFields.astro';
import Icon from '../components/common/Icon.astro';
import StarRating from '../components/reviews/StarRating.astro';
import { getAggregateRating } from '../lib/reviews';
import { formAttributes } from '../lib/forms';
import { siteConfig } from '../config/site';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order,
);
const rating = await getAggregateRating();

const inputClass =
  'w-full rounded-md border border-slate-300 px-4 py-3 text-dark placeholder:text-slate-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30';

// Brendovi za izbor: najčešće marke veš mašina koje servisiramo.
const brands = [
  'Gorenje',
  'Bosch',
  'Samsung',
  'LG',
  'Whirlpool',
  'Candy',
  'Indesit',
  'Electrolux',
  'Miele',
  'Zanussi',
  'Beko',
  'Hisense',
  'VOX',
  'Tesla',
  'Ariston',
];
---

<BaseLayout
  title="Zatražite popravku veš mašine"
  description={`Pošaljite zahtev za servis veš mašine u Beogradu — sve marke, originalni delovi, garancija na popravku. Pozovite ${siteConfig.phone} ili pošaljite zahtev.`}
>
  <PageHero
    title="Zatražite popravku"
    lead="Opišite kvar — javljamo se u najkraćem roku da potvrdimo termin i tačnu cenu pre početka rada."
    crumbs={[{ label: 'Zahtev za ponudu' }]}
  />

  <section class="bg-surface py-16 md:py-20">
    <div class="mx-auto grid max-w-7xl items-start gap-10 px-4 sm:px-6 lg:grid-cols-3 lg:px-8">
      <div class="lg:col-span-2">
        <form
          {...formAttributes('quote')}
          class="grid gap-5 rounded-lg border border-slate-200 bg-white p-6 shadow-sm sm:grid-cols-2 sm:p-8"
        >
          <FormBackendFields formName="quote" />
          <div class="sm:col-span-2">
            <label for="q-service" class="mb-1.5 block font-semibold text-dark">
              Šta treba servisirati? <span class="text-primary" aria-hidden="true">*</span>
            </label>
            <select id="q-service" name="service" required class={inputClass}>
              <option value="">Izaberite uslugu…</option>
              {services.map((s) => <option value={s.data.title}>{s.data.title}</option>)}
              <option value="Nisam siguran">Nisam siguran — treba mi konstatacija kvara</option>
            </select>
          </div>
          <div class="sm:col-span-2">
            <label for="q-brand" class="mb-1.5 block font-semibold text-dark">
              Marka veš mašine
            </label>
            <select id="q-brand" name="brand" class={inputClass}>
              <option value="">Izaberite marku…</option>
              {brands.map((brand) => <option value={brand}>{brand}</option>)}
              <option value="Ostalo">Ostalo</option>
            </select>
          </div>
          <div>
            <label for="q-name" class="mb-1.5 block font-semibold text-dark">
              Ime i prezime <span class="text-primary" aria-hidden="true">*</span>
            </label>
            <input id="q-name" name="name" type="text" required autocomplete="name" class={inputClass} />
          </div>
          <div>
            <label for="q-phone" class="mb-1.5 block font-semibold text-dark">
              Telefon <span class="text-primary" aria-hidden="true">*</span>
            </label>
            <input id="q-phone" name="phone" type="tel" required autocomplete="tel" class={inputClass} />
          </div>
          <div>
            <label for="q-email" class="mb-1.5 block font-semibold text-dark">
              Email <span class="text-primary" aria-hidden="true">*</span>
            </label>
            <input id="q-email" name="email" type="email" required autocomplete="email" class={inputClass} />
          </div>
          <div>
            <label for="q-address" class="mb-1.5 block font-semibold text-dark">
              Adresa u Beogradu <span class="text-primary" aria-hidden="true">*</span>
            </label>
            <input id="q-address" name="address" type="text" required autocomplete="street-address" placeholder="Ulica i broj, Beograd" class={inputClass} />
          </div>
          <div class="sm:col-span-2">
            <label for="q-notes" class="mb-1.5 block font-semibold text-dark">
              Opišite kvar <span class="font-normal text-slate-400">(opciono)</span>
            </label>
            <textarea id="q-notes" name="notes" rows="4" placeholder="Marka i model mašine, opis kvara…" class={inputClass}></textarea>
          </div>
          <div class="sm:col-span-2">
            <button
              type="submit"
              class="inline-flex w-full min-h-[44px] items-center justify-center gap-2 rounded-md bg-primary px-7 py-4 font-heading text-lg font-semibold uppercase tracking-wide text-on-primary transition-colors hover:bg-primary-bright sm:w-auto"
            >
              Pošaljite zahtev
              <Icon name="arrow-right" class="h-5 w-5" />
            </button>
          </div>
        </form>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-24">
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex items-center gap-3">
            <StarRating rating={rating.average} starClass="h-5 w-5" />
            <p class="text-sm font-medium text-slate-600">
              <span class="font-heading text-xl font-bold text-dark">{rating.average}</span>
              / 5 · {rating.count} recenzija
            </p>
          </div>
          <ul class="mt-5 space-y-4 text-sm leading-relaxed text-slate-600">
            <li class="flex items-start gap-3">
              <Icon name="clock" class="mt-0.5 h-5 w-5 shrink-0 text-primary" />
              Javljamo se u najkraćem roku.
            </li>
            <li class="flex items-start gap-3">
              <Icon name="search-check" class="mt-0.5 h-5 w-5 shrink-0 text-primary" />
              Besplatan dolazak i konstatacija kvara uz popravku.
            </li>
            <li class="flex items-start gap-3">
              <Icon name="file-text" class="mt-0.5 h-5 w-5 shrink-0 text-primary" />
              Jasna cena pre početka rada — bez naknadnih iznenađenja.
            </li>
          </ul>
        </div>

        <div class="rounded-lg bg-dark p-6 text-white">
          <h2 class="font-heading text-lg font-bold uppercase">Radije razgovarate telefonom?</h2>
          <a
            href={siteConfig.phoneHref}
            class="mt-3 inline-flex items-center gap-2 font-heading text-2xl font-bold hover:text-primary"
          >
            <Icon name="phone" class="h-6 w-6 text-primary" />
            {siteConfig.phone}
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
