---
/**
 * About page (§6.6): company story, stats wall, team, credentials.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/common/PageHero.astro';
import Icon from '../components/common/Icon.astro';
import SectionHeading from '../components/common/SectionHeading.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import { getAggregateRating } from '../lib/reviews';
import { siteConfig } from '../config/site';
import crewImage from '../assets/about/crew-framing.jpg';
import marcusPhoto from '../assets/team/marcus-rivera.jpg';
import dalePhoto from '../assets/team/dale-hutchins.jpg';
import andrePhoto from '../assets/team/andre-walker.jpg';

const rating = await getAggregateRating();
const yearsInBusiness = new Date().getFullYear() - siteConfig.stats.yearFounded;

const stats = [
  { value: `${yearsInBusiness}`, label: 'Years in business' },
  { value: `${siteConfig.stats.projectsCompleted.toLocaleString('en-US')}+`, label: 'Roofs completed' },
  { value: `${siteConfig.stats.warrantyYears}-yr`, label: 'Workmanship warranty' },
  { value: `${rating.average}★`, label: 'Average review score' },
];

const team = [
  {
    photo: marcusPhoto,
    name: 'Marcus Rivera',
    role: 'Founder & Owner',
    bio: `Started on tear-off crews at nineteen; founded ${siteConfig.logoText} in ${siteConfig.stats.yearFounded} with one truck and a rule — never sell a roof the house doesn't need. Still walks project sites weekly.`,
  },
  {
    photo: dalePhoto,
    name: 'Dale Hutchins',
    role: 'Production Manager',
    bio: 'Thirty years on Colorado roofs. Dale builds every crew schedule, runs quality walks on open projects, and signs off on each roof before the warranty does.',
  },
  {
    photo: andrePhoto,
    name: 'Andre Walker',
    role: 'Crew Lead',
    bio: 'Runs our flagship installation crew and trains every new hire on the nailing-line standard. If your roof went on in the last five years, odds are Andre checked it.',
  },
];

const credentials = [
  {
    icon: 'shield-check',
    title: 'Licensed & insured',
    text: `${siteConfig.licenseLine}, general liability and workers' comp on every job — certificates available on request before work begins.`,
  },
  {
    icon: 'badge-check',
    title: 'Manufacturer certified',
    text: 'Factory-trained and certified installers for the shingle systems we sell, which is what lets us register the strongest available manufacturer warranties.',
  },
  {
    icon: 'thumbs-up',
    title: 'BBB A+ rated',
    text: 'Accredited with an A+ rating — and more importantly, a complaint history you can actually go read.',
  },
  {
    icon: 'users',
    title: 'Our own crews',
    text: 'Core installation crews are ours year-round, not storm-season pickups. The people on your roof went through our training, not a labor broker.',
  },
];
---

<BaseLayout
  title="About Us"
  description={`${siteConfig.name} has installed and repaired more than ${siteConfig.stats.projectsCompleted.toLocaleString('en-US')} roofs across the Denver metro since ${siteConfig.stats.yearFounded}. Meet the team and see how we work.`}
>
  <PageHero
    title="The crew behind the warranty"
    lead={`Roofing since ${siteConfig.stats.yearFounded} — same owner, same phone number, same rule: never sell a roof the house doesn't need.`}
    crumbs={[{ label: 'About' }]}
  />

  <!-- Story -->
  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
      <div>
        <SectionHeading
          eyebrow="Our story"
          title="Built one honest inspection at a time"
        />
        <div class="mt-6 space-y-4 leading-relaxed text-slate-600">
          <p>
            {siteConfig.logoText} started in {siteConfig.stats.yearFounded} with one truck,
            one crew, and a founder who had spent a decade watching storm-chasing
            outfits roll through Denver every hail season — selling roofs
            that didn't need replacing, installing them badly, and disappearing
            before the first winter found the shortcuts.
          </p>
          <p>
            The business plan was to do the opposite: photograph everything,
            put every price in writing, tell homeowners when their roof is
            actually fine, and still be at the same phone number when the
            warranty card gets tested. {yearsInBusiness} years and
            {siteConfig.stats.projectsCompleted.toLocaleString('en-US')}+ roofs
            later, most of our work comes from referrals and repeat customers —
            the cheapest marketing there is, and the only kind you can't buy.
          </p>
          <p>
            Today we run dedicated residential and commercial crews across the
            Denver metro, with the same standard on a $900 repair as on a
            full commercial re-roof: documented, scheduled, and warrantied.
          </p>
        </div>
      </div>
      <Image
        src={crewImage}
        alt={`${siteConfig.logoText} crew member framing a roof against a blue sky`}
        widths={[640, 960, 1280]}
        sizes="(min-width: 1024px) 600px, 100vw"
        class="rounded-lg object-cover shadow-md"
      />
    </div>
  </section>

  <!-- Stats wall -->
  <section class="bg-dark py-14 text-white">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-8 px-4 text-center sm:px-6 lg:grid-cols-4 lg:px-8">
      {
        stats.map((stat) => (
          <div>
            <p class="font-heading text-5xl font-bold text-primary">{stat.value}</p>
            <p class="mt-2 font-heading text-sm font-semibold uppercase tracking-widest text-slate-300">
              {stat.label}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Team -->
  <section class="bg-surface py-16 md:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="The team"
        title="People who answer when the roof doesn't"
        lead="No call centers, no revolving-door sales reps. These are the people whose names go on your project paperwork."
      />
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          team.map((member) => (
            <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
              <Image
                src={member.photo}
                alt={`${member.name}, ${member.role} at ${siteConfig.name}`}
                widths={[400, 800]}
                sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
                class="aspect-square w-full object-cover"
              />
              <div class="p-6">
                <h3 class="font-heading text-xl font-bold uppercase text-dark">{member.name}</h3>
                <p class="font-heading text-sm font-semibold uppercase tracking-wider text-primary-ink">
                  {member.role}
                </p>
                <p class="mt-3 text-sm leading-relaxed text-slate-600">{member.bio}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Credentials -->
  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="Credentials" title="Paperwork worth checking" />
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {
          credentials.map((credential) => (
            <div class="flex gap-4 rounded-lg border border-slate-200 p-6">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md bg-primary/10 text-primary">
                <Icon name={credential.icon} class="h-6 w-6" />
              </span>
              <div>
                <h3 class="font-heading text-lg font-bold uppercase text-dark">{credential.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{credential.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <FinalCTA />
</BaseLayout>
