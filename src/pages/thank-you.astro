---
/**
 * Post-submission confirmation with a clear "what happens next" —
 * the conversion-experience detail most contractor sites skip.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/common/Button.astro';
import Icon from '../components/common/Icon.astro';
import { siteConfig } from '../config/site';

const steps = [
  {
    icon: 'phone',
    title: 'We call you back',
    text: 'A real person from our Denver office — not a call center — reaches out within one business day to confirm the details.',
  },
  {
    icon: 'calendar',
    title: 'We schedule your inspection',
    text: 'Pick a time that works. The 21-point inspection takes about 45 minutes, and you don’t need to be on the roof with us.',
  },
  {
    icon: 'file-text',
    title: 'You get a written quote',
    text: 'A line-item quote with photos of what we found, within 24 hours of the inspection. Free either way, zero pressure.',
  },
];
---

<BaseLayout
  title="Thank You — Request Received"
  description="Your request has been received. Here's what happens next."
  noindex
>
  <section class="bg-dark py-20 text-white md:py-28">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-primary">
        <Icon name="check" class="h-8 w-8 text-white" strokeWidth={3} />
      </span>
      <h1 class="mt-6 font-heading text-4xl font-bold uppercase leading-tight md:text-5xl">
        Got it — you're on the list
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-slate-300">
        Your request just landed in our office. Here's exactly what happens
        from here:
      </p>
    </div>
  </section>

  <section class="bg-surface py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <ol class="grid gap-6 md:grid-cols-3">
        {
          steps.map((step, i) => (
            <li class="relative rounded-lg border border-slate-200 bg-white p-6 pt-8 shadow-sm">
              <span
                class="absolute -top-4 left-6 flex h-9 w-9 items-center justify-center rounded-md bg-primary font-heading text-lg font-bold text-on-primary"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <Icon name={step.icon} class="h-6 w-6 text-primary" />
              <h2 class="mt-3 font-heading text-lg font-bold uppercase text-dark">{step.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{step.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-12 rounded-lg border border-slate-200 bg-white p-6 text-center shadow-sm">
        <p class="font-heading text-xl font-bold uppercase text-dark">
          Roof actively leaking right now?
        </p>
        <p class="mt-1 text-sm text-slate-600">
          Don't wait for the callback — our storm line answers 24/7.
        </p>
        <div class="mt-5 flex flex-wrap justify-center gap-4">
          <Button href={siteConfig.phoneHref}>
            <Icon name="phone" class="h-5 w-5" />
            Call {siteConfig.phone}
          </Button>
          <Button href="/" variant="dark">Back to home</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
