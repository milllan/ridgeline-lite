---
/**
 * About page (§6.6): company story, stats wall, team, credentials.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/common/PageHero.astro';
import Icon from '../components/common/Icon.astro';
import SectionHeading from '../components/common/SectionHeading.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import { getAggregateRating } from '../lib/reviews';
import { siteConfig } from '../config/site';
import crewImage from '../assets/about/crew-framing.jpg';
import marcusPhoto from '../assets/team/marcus-rivera.jpg';

const rating = await getAggregateRating();
const yearsInBusiness = new Date().getFullYear() - siteConfig.stats.yearFounded;

const stats = [
  { value: `${yearsInBusiness}`, label: 'Godina iskustva' },
  { value: `${siteConfig.stats.projectsCompleted.toLocaleString('sr-Latn-RS')}+`, label: 'Završenih popravki' },
  // TODO: potvrditi trajanje garancije sa biznisom — u site.ts stoji
  // napomena da je stvarno 6–12 meseci; prikazujemo config vrednost.
  { value: `${siteConfig.stats.warrantyYears} god.`, label: 'Garancija na popravku' },
  { value: `${rating.average}★`, label: 'Prosečna ocena' },
];

// TODO: pravo ime, biografija i fotografija majstora — placeholder kartica.
const team = [
  {
    photo: marcusPhoto,
    name: 'Glavni majstor',
    role: 'Servis i popravka veš mašina',
    bio: `Naš glavni majstor radi sa veš mašinama svih marki – od utvrđivanja kvara na licu mesta do zamene dela i garancije na popravku. Na broj ${siteConfig.phone} javlja se majstor, ne kol centar.`,
  },
];

const credentials = [
  {
    icon: 'shield-check',
    title: 'Registrovana radionica',
    text: `${siteConfig.licenseLine}.`,
  },
  {
    icon: 'badge-check',
    title: 'Originalni rezervni delovi',
    text: 'Radimo sa originalnim rezervnim delovima, prilagođenim marki i modelu vaše mašine – zamenske delove ugrađujemo samo uz vašu saglasnost.',
  },
  {
    icon: 'thumbs-up',
    title: 'Garancija na sve popravke',
    text: 'Na svaku popravku dajemo garanciju na rad i ugrađene delove – pitajte za uslove garancije pre početka posla.',
  },
  {
    icon: 'users',
    title: 'Iskusan majstor',
    text: `Majstor koji već ${yearsInBusiness} godina servisira veš mašine svih marki širom Beograda.`,
  },
];
---

<BaseLayout
  title="O nama"
  description={`${siteConfig.name} – servis i popravka veš mašina u Beogradu od ${siteConfig.stats.yearFounded}. godine. Upoznajte našeg majstora i pogledajte kako radimo.`}
>
  <PageHero
    title="Majstor iza garancije"
    lead={`Servis i popravka veš mašina od ${siteConfig.stats.yearFounded}. godine – isti majstor, isti broj telefona i isto pravilo: ne popravljamo ono što ne treba popravljati.`}
    crumbs={[{ label: 'O nama' }]}
  />

  <!-- Story -->
  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
      <div>
        <SectionHeading
          eyebrow="Naša priča"
          title="Krenuli od poštenog utvrđivanja kvara"
        />
        <div class="mt-6 space-y-4 leading-relaxed text-slate-600">
          <p>
            {siteConfig.logoText} je radionica za servis i popravku veš mašina
            iz Beograda. Krenuli smo od jednostavne ideje: majstor dolazi na
            adresu, utvrđuje kvar na licu mesta i kaže vam šta stvarno treba
            popraviti – pre nego što bilo šta košta.
          </p>
          <p>
            Uz dobru dijagnozu ide i jasna cena: pre početka rada znate tačno
            šta se popravlja i koliko košta, a mašinu ne diramo ako popravka
            nema smisla. Od {siteConfig.stats.yearFounded}. godine završili
            smo više od {siteConfig.stats.projectsCompleted.toLocaleString('sr-Latn-RS')}{" "}
            popravki, i većina novih poziva dolazi po preporuci starih
            kupaca – najbolji dokaz da pravilo držimo i dalje.
          </p>
          <p>
            Danas izlazimo na teren u celom Beogradu, radimo sa originalnim
            rezervnim delovima i na svaku popravku dajemo garanciju na rad i
            delove – ista merila za manju i veću popravku.
          </p>
        </div>
      </div>
      <!-- TODO: zameniti placeholder fotografiju (krovopokrivački tim) slikom naše radionice -->
      <Image
        src={crewImage}
        alt={`${siteConfig.name} – naša radionica`}
        widths={[640, 960, 1280]}
        sizes="(min-width: 1024px) 600px, 100vw"
        class="rounded-lg object-cover shadow-md"
      />
    </div>
  </section>

  <!-- Stats wall -->
  <section class="bg-dark py-14 text-white">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-8 px-4 text-center sm:px-6 lg:grid-cols-4 lg:px-8">
      {
        stats.map((stat) => (
          <div>
            <p class="font-heading text-5xl font-bold text-primary">{stat.value}</p>
            <p class="mt-2 font-heading text-sm font-semibold uppercase tracking-widest text-slate-300">
              {stat.label}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Team -->
  <section class="bg-surface py-16 md:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Tim"
        title="Majstor koji se javlja na telefon"
        lead="Bez posrednika i kol centara – telefon uzima majstor koji će i popraviti mašinu."
      />
      <!-- Single technician card (collapsed from a 3-person grid): one card
           reads as intentional when centered at reading width. -->
      <!-- TODO: pravo ime, biografija i fotografija majstora -->
      <div class="mt-12 mx-auto max-w-md">
        {
          team.map((member) => (
            <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
              <Image
                src={member.photo}
                alt={`${member.name} – ${member.role}, ${siteConfig.name}`}
                widths={[400, 800]}
                sizes="(min-width: 640px) 448px, 100vw"
                class="aspect-square w-full object-cover"
              />
              <div class="p-6">
                <h3 class="font-heading text-xl font-bold uppercase text-dark">{member.name}</h3>
                <p class="font-heading text-sm font-semibold uppercase tracking-wider text-primary-ink">
                  {member.role}
                </p>
                <p class="mt-3 text-sm leading-relaxed text-slate-600">{member.bio}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Credentials -->
  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="Naše prednosti" title="Radionica kojoj možete verovati" />
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {
          credentials.map((credential) => (
            <div class="flex gap-4 rounded-lg border border-slate-200 p-6">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md bg-primary/10 text-primary">
                <Icon name={credential.icon} class="h-6 w-6" />
              </span>
              <div>
                <h3 class="font-heading text-lg font-bold uppercase text-dark">{credential.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{credential.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <FinalCTA />
</BaseLayout>
