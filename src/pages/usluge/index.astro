---
/**
 * Services page – Lite edition: all six services on one page with
 * photos and process overviews. (Ridgeline Pro gives each service its
 * own landing page with FAQs and related projects.)
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/common/PageHero.astro';
import Button from '../../components/common/Button.astro';
import Icon from '../../components/common/Icon.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import FaqSection from '../../components/sections/FaqSection.astro';
import { siteConfig } from '../../config/site';

// Najčešća pitanja po simptomu – 1:1 na usluge (epic #28 C, #22 §3).
// DRAFT: potvrditi formulacije sa Dejanom pre lansiranja; činjenice su
// iz odobrene liste (besplatna konstatacija uz popravku, originalni
// delovi / zamenski uz saglasnost, garancija – delovi 1 godina,
// hibridni model teren + radionica).
const faqItems = [
  {
    question: 'Mašina ne centrifuriše. Šta je najčešći uzrok?',
    answer:
      'Najčešće je do pumpe, pritiska ili elektronike. Pregledamo mašinu na vašoj adresi, a tačan uzrok i cenu popravke znate pre početka rada.',
  },
  {
    question: 'Curi voda ispod mašine. Može li to da se popravi?',
    answer:
      'Curenje najčešće dolazi od zaptivača na vratima ili od creva. To su popravke koje radimo kod vas u stanu, a zaptivače menjamo originalnim delovima.',
  },
  {
    question: 'Mašina buči i tutnji pri centrifuzi.',
    answer:
      'Bučna centrifuga najčešće znači istrošene ležajeve. Zamena ležajeva je obimniji posao, pa mašinu po potrebi preuzimamo u radionicu i vraćamo je popravljenu.',
  },
  {
    question: 'Voda ostaje u bubnju, mašina ne izbacuje vodu.',
    answer:
      'Uzrok je obično pumpa ili začepljen filter. Kvar konstatujemo kod vas, a pumpu menjamo uz garanciju na rad i delove.',
  },
  {
    question: 'Voda se ne greje ili mašina loše pere.',
    answer:
      'Najčešći krivac je grejač. Grejač menjamo originalnim delom, a zamenski deo ugrađujemo samo uz vašu saglasnost.',
  },
  {
    question: 'Programator ne reaguje ili se program zaglavi.',
    answer:
      'Problem može biti u programatoru ili u elektronici mašine. Servisiramo i te sklopove, a procenu radimo na licu mesta, po marki i modelu.',
  },
  {
    question: 'Da li dolazite na adresu u Beogradu?',
    answer:
      'Da, manje kvarove otklanjamo kod vas u stanu, u svim beogradskim opštinama. Za obimnije popravke preuzimamo mašinu u radionicu i vraćamo je popravljenu. Dolazak i konstatacija kvara su besplatni uz popravku.',
  },
  {
    question: 'Da li dajete garanciju na popravku?',
    answer:
      'Da, na rad i ugrađene delove dajemo garanciju, a garancija na delove traje godinu dana. Koristimo originalne delove, a zamenske ugrađujemo samo uz vašu saglasnost.',
  },
];

const brands = (await getCollection('brands')).sort(
  (a, b) => a.data.order - b.data.order,
);
const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Usluge servisa veš mašina u Beogradu"
  description={`Popravka veš mašina u Beogradu za sve marke. Dolazimo na kućnu adresu, ugrađujemo originalne delove i dajemo garanciju na rad. Pozovite ${siteConfig.phone}.`}
  faq={faqItems}
>
  <PageHero
    title="Usluge"
    lead="Otklanjamo sve kvarove, od bučnog ležaja do pumpe koja ne izbacuje vodu: manje popravke radimo na vašoj adresi, a obimnije u radionici, uz preuzimanje mašine. Popravljamo sve marke. Konstatacija kvara je besplatna uz popravku, a na ugrađene delove i rad dobijate garanciju."
    crumbs={[{ label: 'Usluge' }]}
  />

  <section class="bg-surface py-16 md:py-20">
    <div class="mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:px-8">
      {
        services.map((service, i) => (
          <article class="grid overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm md:grid-cols-2">
            <div class:list={['relative aspect-video md:aspect-auto md:min-h-full', i % 2 === 1 && 'md:order-last']}>
              <Image
                src={service.data.heroImage}
                alt={service.data.heroImageAlt}
                widths={[480, 768, 1200]}
                sizes="(min-width: 768px) 50vw, 100vw"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
            <div class="p-7 md:p-9">
              <span class="flex h-12 w-12 items-center justify-center rounded-md bg-primary/10 text-primary">
                <Icon name={service.data.icon} class="h-6 w-6" />
              </span>
              <h2 class="mt-4 font-heading text-2xl font-bold uppercase text-dark">
                {service.data.title}
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{service.data.excerpt}</p>
              <ol class="mt-5 space-y-2">
                {service.data.processSteps.map((step, n) => (
                  <li class="flex items-start gap-2.5 text-sm text-slate-600">
                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-sm bg-primary/10 font-heading text-xs font-bold text-primary-ink">
                      {n + 1}
                    </span>
                    <span>
                      <strong class="font-semibold text-dark">{step.title}.</strong> {step.description}
                    </span>
                  </li>
                ))}
              </ol>
              <div class="mt-6">
                <Button href="/zatrazi-ponudu/">Zatražite ponudu</Button>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {brands.length > 0 && (
    <section class="bg-white py-12 md:py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        {/* UI "marke" vs URL /brendovi/ – intentional split (muse #4) */}
        <h2 class="font-heading text-xl font-bold uppercase text-dark">
          Servis po markama
        </h2>
      <ul class="mt-5 flex flex-wrap gap-3">
        {
          brands.map((brand) => (
            <li>
              <a
                href={`/brendovi/${brand.id.replace(/\.mdx$/, '')}/`}
                class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-surface px-5 py-2 text-sm font-semibold text-slate-700 transition-colors hover:border-primary/50 hover:text-dark"
              >
                <Icon name="wrench" class="h-4 w-4 text-primary" />
                {brand.data.name} servis
              </a>
            </li>
          ))
        }
        </ul>
      </div>
    </section>
  )}

  <FaqSection title="Najčešća pitanja o kvarovima" items={faqItems} />

  <FinalCTA
    title="Niste sigurni u čemu je problem?"
    lead="Javite nam kako se mašina ponaša. Doći ćemo da pregledamo mašinu i utvrdimo kvar i zamenićemo samo ono što je stvarno dotrajalo."
  />
</BaseLayout>
