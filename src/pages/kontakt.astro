---
/**
 * Contact page: short form + NAP block (consistent with the JSON-LD),
 * hours, and the service-area map.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/common/PageHero.astro';
import FormBackendFields from '../components/common/FormBackendFields.astro';
import Icon from '../components/common/Icon.astro';
import FormAjaxSubmit from '../components/common/FormAjaxSubmit.astro';
import ServiceAreaMap from '../components/sections/ServiceAreaMap.astro';
import { formAttributes } from '../lib/forms';
import { siteConfig, hasEmail } from '../config/site';
import { getCollection } from 'astro:content';

const { address } = siteConfig;
const opstine = (await getCollection('opstine')).sort(
  (a, b) => a.data.order - b.data.order,
);

const inputClass =
  'w-full rounded-md border border-slate-300 px-4 py-3 text-dark placeholder:text-slate-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30';
---

<BaseLayout
  title="Kontakt"
  description={`Kontaktirajte ${siteConfig.name} – pozovite ${siteConfig.phone} ili pošaljite poruku. Servis i popravka veš mašina na terenu u celom Beogradu.`}
>
  <PageHero
    title="Razgovarajte direktno sa Dejanom"
    lead="Pozovite, pišite ili pošaljite poruku – odgovaramo u najkraćem roku."
    crumbs={[{ label: 'Kontakt' }]}
  />

  <section class="bg-surface py-16 md:py-20">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-5 lg:px-8">
      <!-- Form -->
      <div class="lg:col-span-3">
        <h2 class="font-heading text-2xl font-bold uppercase text-dark">Pošaljite nam poruku</h2>
        <p class="mt-2 text-sm text-slate-600">
          Treba li vam ponuda? <a href="/zatrazi-ponudu/" class="font-medium text-accent-ink hover:underline">Forma za zahtev ponude</a>
          prikuplja detalje o kvaru i mašini i obično je brža. Za sve ostalo, ova poruka sasvim dobro funkcioniše.
        </p>
        <form {...formAttributes('contact')} class="mt-6 grid gap-5 sm:grid-cols-2">
          <FormBackendFields formName="contact" />
          <div>
            <label for="contact-name" class="mb-1.5 block text-sm font-semibold text-dark">
              Ime i prezime <span class="text-primary" aria-hidden="true">*</span>
            </label>
            <input
              id="contact-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              class={inputClass}
            />
          </div>
          <div>
            <label for="contact-phone" class="mb-1.5 block text-sm font-semibold text-dark">
              Telefon <span class="text-primary" aria-hidden="true">*</span>
            </label>
            <input
              id="contact-phone"
              name="phone"
              type="tel"
              required
              autocomplete="tel"
              class={inputClass}
            />
          </div>
          <div class="sm:col-span-2">
            <label for="contact-email" class="mb-1.5 block text-sm font-semibold text-dark">
              Email <span class="text-primary" aria-hidden="true">*</span>
            </label>
            <input
              id="contact-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class={inputClass}
            />
          </div>
          <div class="sm:col-span-2">
            <label for="contact-message" class="mb-1.5 block text-sm font-semibold text-dark">
              Kako vam možemo pomoći? <span class="text-primary" aria-hidden="true">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              required
              placeholder="Opišite ukratko kvar i marku mašine…"
              class={inputClass}
            ></textarea>
          </div>
          <div class="sm:col-span-2">
            <button
              type="submit"
              class="inline-flex items-center justify-center gap-2 rounded-md bg-primary px-7 py-4 font-heading text-lg font-semibold uppercase tracking-wide text-on-primary transition-colors hover:bg-primary-bright"
            >
              Pošaljite poruku
              <Icon name="arrow-right" class="h-5 w-5" />
            </button>
          </div>
          <p data-form-status role="status" class="sm:col-span-2 min-h-[1.25rem] text-sm font-medium text-red-600"></p>
        </form>
      </div>

      <!-- NAP / hours / map -->
      <div class="lg:col-span-2">
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="font-heading text-xl font-bold uppercase text-dark">
            {siteConfig.name}
          </h2>
          <address class="mt-4 space-y-3 text-sm not-italic text-slate-600">
            <p class="flex items-start gap-2.5">
              <Icon name="map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
              <span>
                {address.street}<br />
                {address.zip} {address.city}
              </span>
            </p>
            <p>
              <a
                href={siteConfig.phoneHref}
                class="flex items-center gap-2.5 font-semibold text-dark hover:text-primary-ink"
              >
                <Icon name="phone" class="h-4 w-4 shrink-0 text-primary" />
                {siteConfig.phone}
              </a>
            </p>
            {hasEmail && (
              <p>
                <a
                  href={`mailto:${siteConfig.email}`}
                  class="flex items-center gap-2.5 hover:text-primary-ink"
                >
                  <Icon name="mail" class="h-4 w-4 shrink-0 text-primary" />
                  {siteConfig.email}
                </a>
              </p>
            )}
          </address>

          <h3 class="mt-6 font-heading text-base font-bold uppercase tracking-wide text-dark">
            Radno vreme
          </h3>
          <ul class="mt-2 space-y-1.5 text-sm text-slate-600">
            {
              siteConfig.hours.map((row) => (
                <li class="flex justify-between gap-4">
                  <span>{row.days}</span>
                  <span class="text-slate-500">
                    {row.close ? `${row.open} – ${row.close}` : row.open}
                  </span>
                </li>
              ))
            }
          </ul>
          <p class="mt-3 flex items-center gap-2 text-sm font-medium text-primary-ink">
            <Icon name="zap" class="h-4 w-4" />
            {siteConfig.emergencyNote}
          </p>
        </div>

        <div class="mt-6">
          <ServiceAreaMap />
          <p class="mt-3 text-sm text-slate-600">
            Pokrivamo sve beogradske opštine:{' '}
            {
              opstine.map((opstina, i) => (
                <>
                  {i > 0 && '· '}
                  <a
                    href={`/lokacije/${opstina.id.replace(/\.mdx$/, '')}/`}
                    class="font-medium text-accent-ink hover:underline"
                  >
                    {opstina.data.title.replace('Servis veš mašina ', '')}
                  </a>
                </>
              ))
            }
          </p>
        </div>
      </div>
    </div>
  </section>
  <FormAjaxSubmit />
</BaseLayout>
