---
/**
 * Services page – AI Images Edition:
 * Clone of /usluge/ showcasing custom-generated AI photography
 * specifically matching domestic washing machine repair services in Belgrade.
 * Includes interactive comparison controls to review AI vs. Stock photos.
 */
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/common/PageHero.astro';
import Button from '../components/common/Button.astro';
import Icon from '../components/common/Icon.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import { siteConfig } from '../config/site';

// AI Images
import imgPopravka from '../assets/services-ai/ai-popravka-svi-kvarovi.jpg';
import imgPumpe from '../assets/services-ai/ai-zamena-pumpe.jpg';
import imgGrejaci from '../assets/services-ai/ai-zamena-grejaca.jpg';
import imgLezajevi from '../assets/services-ai/ai-zamena-lezajeva.jpg';
import imgProgramatori from '../assets/services-ai/ai-popravka-programatora.jpg';
import imgPreventivno from '../assets/services-ai/ai-preventivno-odrzavanje.jpg';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order,
);

const aiImages: Record<string, { image: ImageMetadata; alt: string }> = {
  'popravka-ves-masina': {
    image: imgPopravka,
    alt: 'Majstor u kupatilu vrši dijagnostiku i popravku veš mašine mernim instrumentom',
  },
  'zamena-pumpe': {
    image: imgPumpe,
    alt: 'Zamena pumpe za izbacivanje vode i čišćenje filtera na veš mašini',
  },
  'zamena-grejaca': {
    image: imgGrejaci,
    alt: 'Ispitivanje i zamena grejača veš mašine mernim instrumentom – novi i stari grejač',
  },
  'zamena-lezajeva-zaptivaca': {
    image: imgLezajevi,
    alt: 'Zamena ležajeva i semeringa na rasklopljenom bubnju veš mašine u radionici',
  },
  'popravka-programatora': {
    image: imgProgramatori,
    alt: 'Dijagnostika i servis elektronskog modula i programatora veš mašine',
  },
  'preventivno-odrzavanje': {
    image: imgPreventivno,
    alt: 'Preventivni servis i temeljno čišćenje dozatora i gume na veš mašini',
  },
};
---

<BaseLayout
  title="Usluge servisa veš mašina u Beogradu (AI varijanta)"
  description={`Popravka veš mašina u Beogradu za sve marke. Dolazimo na kućnu adresu, ugrađujemo originalne delove i dajemo garanciju na rad. Pozovite ${siteConfig.phone}.`}
  noindex={true}
>
  <!-- Comparison Toolbar -->
  <aside aria-label="Uporedni prikaz" class="sticky top-0 z-30 border-b border-primary/20 bg-amber-50/95 backdrop-blur-sm py-2.5 px-4 sm:px-6 shadow-sm">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 text-sm">
      <div class="flex items-center gap-2">
        <span class="inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="font-bold text-slate-800">Pregled varijante:</span>
        <span class="text-slate-700 text-xs sm:text-sm">Prikazane su nove AI fotografije prilagođene servisu veš mašina.</span>
      </div>
      <div class="flex items-center gap-2">
        <a
          href="/usluge/"
          class="inline-flex items-center gap-1 rounded border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm hover:bg-slate-50 transition"
        >
          ← Trenutne stock slike (/usluge/)
        </a>
        <button
          id="toggle-comparison"
          type="button"
          class="inline-flex items-center gap-1.5 rounded bg-primary px-3 py-1.5 text-xs font-semibold text-white shadow-sm hover:bg-primary/90 transition cursor-pointer"
        >
          <span id="btn-text">Uporedni prikaz (Side-by-side)</span>
        </button>
      </div>
    </div>
  </aside>

  <PageHero
    title="Usluge (AI fotografije)"
    lead="Otklanjamo sve kvarove, od bučnog ležaja do pumpe koja ne izbacuje vodu: manje popravke radimo na vašoj adresi, a obimnije u radionici, uz preuzimanje mašine. Popravljamo sve marke. Konstatacija kvara je besplatna uz popravku, a na ugrađene delove i rad dobijate garanciju."
    crumbs={[{ label: 'Usluge', href: '/usluge/' }, { label: 'AI varijanta' }]}
  />

  <section class="bg-surface py-16 md:py-20">
    <div class="mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:px-8">
      {
        services.map((service, i) => {
          const ai = aiImages[service.id];
          return (
            <article class="service-card grid overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm md:grid-cols-2">
              <div class:list={['image-col relative aspect-video md:aspect-auto md:min-h-full', i % 2 === 1 && 'md:order-last']}>
                <!-- AI Image (Default) -->
                <div class="ai-image-wrap relative h-full w-full">
                  <span class="absolute top-3 left-3 z-10 rounded bg-black/75 px-2.5 py-1 text-xs font-semibold text-white backdrop-blur-xs tracking-wide">
                    AI fotografija
                  </span>
                  <Image
                    src={ai?.image || service.data.heroImage}
                    alt={ai?.alt || service.data.heroImageAlt}
                    widths={[480, 768, 1200]}
                    sizes="(min-width: 768px) 50vw, 100vw"
                    class="h-full w-full object-cover"
                  />
                </div>

                <!-- Stock Image (Shown in Side-by-side / toggle mode) -->
                <div class="stock-image-wrap hidden relative h-full w-full border-t md:border-t-0 md:border-l border-slate-200">
                  <span class="absolute top-3 left-3 z-10 rounded bg-slate-800/80 px-2.5 py-1 text-xs font-semibold text-white backdrop-blur-xs tracking-wide">
                    Trenutna stock slika
                  </span>
                  <Image
                    src={service.data.heroImage}
                    alt={service.data.heroImageAlt}
                    widths={[480, 768, 1200]}
                    sizes="(min-width: 768px) 50vw, 100vw"
                    class="h-full w-full object-cover"
                  />
                </div>
              </div>

              <div class="p-7 md:p-9 flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between">
                    <span class="flex h-12 w-12 items-center justify-center rounded-md bg-primary/10 text-primary">
                      <Icon name={service.data.icon} class="h-6 w-6" />
                    </span>
                    <button
                      type="button"
                      class="card-toggle text-xs font-medium text-primary hover:underline cursor-pointer flex items-center gap-1"
                      data-index={i}
                    >
                      <span>Prikaži stock sliku</span> ⇄
                    </button>
                  </div>
                  <h2 class="mt-4 font-heading text-2xl font-bold uppercase text-dark">
                    {service.data.title}
                  </h2>
                  <p class="mt-2 text-sm leading-relaxed text-slate-600">{service.data.excerpt}</p>
                  <ol class="mt-5 space-y-2">
                    {service.data.processSteps.map((step, n) => (
                      <li class="flex items-start gap-2.5 text-sm text-slate-600">
                        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-sm bg-primary/10 font-heading text-xs font-bold text-primary-ink">
                          {n + 1}
                        </span>
                        <span>
                          <strong class="font-semibold text-dark">{step.title}.</strong> {step.description}
                        </span>
                      </li>
                    ))}
                  </ol>
                </div>
                <div class="mt-6 flex items-center justify-between">
                  <Button href="/zatrazi-ponudu/">Zatražite ponudu</Button>
                  <span class="text-xs text-slate-400 font-mono">ID: {service.id}</span>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <FinalCTA
    title="Niste sigurni u čemu je problem?"
    lead="Javite nam kako se mašina ponaša. Doći ćemo da pregledamo mašinu i utvrdimo kvar i zamenićemo samo ono što je stvarno dotrajalo."
  />

  <script is:inline>
    // Side-by-side global toggle
    const toggleBtn = document.getElementById('toggle-comparison');
    const btnText = document.getElementById('btn-text');
    let isSideBySide = false;

    toggleBtn?.addEventListener('click', () => {
      isSideBySide = !isSideBySide;
      const articles = document.querySelectorAll('.service-card');
      
      articles.forEach((card) => {
        const imageCol = card.querySelector('.image-col');
        const stockWrap = card.querySelector('.stock-image-wrap');
        const aiWrap = card.querySelector('.ai-image-wrap');
        
        if (isSideBySide) {
          card.classList.remove('md:grid-cols-2');
          card.classList.add('grid-cols-1');
          imageCol.classList.remove('md:aspect-auto', 'md:min-h-full');
          imageCol.classList.add('grid', 'grid-cols-1', 'sm:grid-cols-2', 'gap-0');
          stockWrap.classList.remove('hidden');
          aiWrap.classList.remove('hidden');
        } else {
          card.classList.add('md:grid-cols-2');
          card.classList.remove('grid-cols-1');
          imageCol.classList.add('md:aspect-auto', 'md:min-h-full');
          imageCol.classList.remove('grid', 'grid-cols-1', 'sm:grid-cols-2', 'gap-0');
          stockWrap.classList.add('hidden');
          aiWrap.classList.remove('hidden');
        }
      });

      if (btnText) {
        btnText.textContent = isSideBySide ? 'Prikaži samo AI slike' : 'Uporedni prikaz (Side-by-side)';
      }
    });

    // Per-card toggle
    document.querySelectorAll('.card-toggle').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const card = e.currentTarget.closest('.service-card');
        const aiWrap = card.querySelector('.ai-image-wrap');
        const stockWrap = card.querySelector('.stock-image-wrap');
        const label = e.currentTarget.querySelector('span');
        
        const showingStock = !stockWrap.classList.contains('hidden') && aiWrap.classList.contains('hidden');
        
        if (showingStock) {
          aiWrap.classList.remove('hidden');
          stockWrap.classList.add('hidden');
          if (label) label.textContent = 'Prikaži stock sliku';
        } else {
          aiWrap.classList.add('hidden');
          stockWrap.classList.remove('hidden');
          if (label) label.textContent = 'Prikaži AI sliku';
        }
      });
    });
  </script>
</BaseLayout>
