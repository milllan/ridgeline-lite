---
/**
 * Branded 404 with useful next steps.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/common/Button.astro';
import Icon from '../components/common/Icon.astro';
import { siteConfig } from '../config/site';

const links = [
  { label: 'Naše usluge', href: '/usluge/' },
  { label: 'O nama', href: '/o-nama/' },
  { label: 'Kontakt', href: '/kontakt/' },
];
---

<BaseLayout
  title="Stranica nije pronađena"
  description="Izgleda da je ova stranica ostala u centrifuzi. Evo kako da se vratite na pravi put."
  noindex
>
  <section class="bg-dark py-24 text-white md:py-32">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <p class="font-heading text-7xl font-bold uppercase text-primary md:text-8xl">404</p>
      <h1 class="mt-4 font-heading text-3xl font-bold uppercase leading-tight md:text-4xl">
        Izgleda da je ova stranica ostala u centrifuzi
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-slate-300">
        Stranica koju tražite ne postoji ili je premeštena. Za razliku od
        veš mašine, ovde popravka ne zahteva majstora:
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="rounded-md border border-white/30 px-5 py-2.5 font-heading text-base font-semibold uppercase tracking-wide text-white transition-colors hover:border-primary hover:text-primary"
            >
              {link.label}
            </a>
          ))
        }
      </div>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <Button href="/" size="lg">Nazad na početnu</Button>
        <Button href={siteConfig.phoneHref} variant="outline-light" size="lg">
          <Icon name="phone" class="h-5 w-5" />
          {siteConfig.phone}
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
